---
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import WaveDivider from "../components/WaveDivider.astro";
import { contact } from "../data/contact";

// Todos los títulos de src/assets/studies/titulo-N.jpg, ordenados por N (las claves del glob vienen
// en orden alfabético: titulo-10 antes que titulo-2). Para sumar uno nuevo alcanza con agregar el
// archivo siguiente; no hay que tocar este código.
const modules = import.meta.glob<{ default: ImageMetadata }>("../assets/studies/titulo-*.jpg", { eager: true });

const titles = await Promise.all(
  Object.entries(modules)
    .map(([path, mod]) => ({ num: Number(path.match(/titulo-(\d+)\.jpg$/)?.[1] ?? 0), image: mod.default }))
    .sort((a, b) => a.num - b.num)
    .map(async ({ image }, index) => ({
      image,
      alt: `Certificado ${index + 1} de ${contact.owner}`,
      // Versión grande para el lightbox (WebP, sin pasar del tamaño original).
      full: await getImage({ src: image, format: "webp", width: Math.min(image.width, 1280) }),
    })),
);
---

<Layout title={`Sobre mí | ${contact.brand}`} description={`Conocé el estudio de ${contact.brand} y a las personas detrás del salón.`}>
  <Navbar />

  <main>
    {/* Encabezado oscuro: el Navbar es transparente con texto blanco, así que la página arranca
       sobre fondo oscuro igual que la home (video del Hero). */}
    <section
      class="relative overflow-hidden bg-gradient-to-br from-warmgray-900 via-warmgray-800 to-warmgray-900 px-4 pt-28 pb-24 text-center sm:px-6 sm:pt-36 md:pb-32 dark:from-black dark:via-warmgray-900 dark:to-black"
    >
      <div aria-hidden="true" class="pointer-events-none absolute -top-32 -left-24 h-72 w-72 rounded-full bg-rose-muted/20 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-32 h-72 w-72 rounded-full bg-rose-muted-strong/15 blur-3xl"></div>

      <div class="relative z-10 mx-auto max-w-2xl">
        <p class="font-sans text-xs font-semibold tracking-widest text-rose-300 uppercase">Conocenos</p>
        <h1 class="mt-2 font-display text-4xl text-white md:text-5xl">Sobre mí</h1>
        {/* Placeholder genérico — se reemplaza por la biografía real en el próximo paso. */}
        <p class="mx-auto mt-4 font-sans text-warmgray-100">
          Detrás de {contact.brand} hay años de formación, cursos y certificaciones en cuidado capilar, estética y bienestar. Cada
          espacio del salón —y cada título en la pared de nuestro estudio— refleja ese compromiso con seguir aprendiendo para
          ofrecerte siempre el mejor cuidado.
        </p>
      </div>

      <WaveDivider
        id="about-titles"
        color4="#FFF5F8"
        darkColor1="#a9697f"
        darkColor2="#c98ba0"
        darkColor3="#5c5049"
        darkColor4="#2b2422"
      />
    </section>

    <section id="titulos" class="bg-rose-50 px-3 py-16 sm:px-6 md:py-24 dark:bg-warmgray-900">
      <div class="mx-auto max-w-6xl">
        <div class="mb-10 text-center md:mb-14">
          <p class="font-sans text-xs font-semibold tracking-widest text-rose-700 uppercase dark:text-rose-300">Formación</p>
          <h2 class="mt-2 font-display text-3xl text-warmgray-800 md:text-5xl dark:text-warmgray-100">Títulos y certificaciones</h2>
          <p class="mx-auto mt-3 max-w-xl font-sans text-warmgray-700 dark:text-warmgray-100">Tocá cualquier título para verlo en grande.</p>
        </div>

        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 lg:grid-cols-5">
          {
            titles.map((title) => (
              <li>
                <button
                  type="button"
                  data-title-thumb
                  data-full-src={title.full.src}
                  data-full-width={title.full.attributes.width}
                  data-full-height={title.full.attributes.height}
                  aria-haspopup="dialog"
                  class="group block w-full cursor-pointer overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-rose-200 transition-shadow hover:shadow-md focus-visible:ring-2 focus-visible:ring-rose-700 focus-visible:outline-none dark:bg-warmgray-800 dark:ring-warmgray-700 dark:focus-visible:ring-rose-300"
                >
                  <Picture
                    src={title.image}
                    formats={["avif", "webp"]}
                    widths={[160, 240, 320, 480]}
                    sizes="(min-width: 1024px) 220px, (min-width: 768px) 25vw, (min-width: 640px) 33vw, 50vw"
                    alt={title.alt}
                    loading="lazy"
                    class="aspect-[3/4] h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100"
                  />
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  {/* Lightbox: un título ampliado, nada más. Se cierra con la X, con Esc o tocando afuera. */}
  <dialog
    data-title-lightbox
    aria-label="Título ampliado"
    class="m-auto max-h-none max-w-none overflow-visible bg-transparent p-0 backdrop:bg-black/85"
  >
    <button
      type="button"
      data-lightbox-close
      aria-label="Cerrar"
      class="fixed top-3 right-3 z-10 flex h-11 w-11 cursor-pointer items-center justify-center rounded-full bg-white/15 text-white transition-colors hover:bg-white/25 focus-visible:ring-2 focus-visible:ring-rose-300 focus-visible:outline-none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
    <img data-lightbox-image alt="" class="block h-auto max-h-[calc(100dvh-6rem)] w-auto max-w-[calc(100vw-2rem)] rounded-lg object-contain shadow-2xl" />
  </dialog>

  <Footer />
</Layout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-title-lightbox]");
  const image = dialog?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const closeBtn = dialog?.querySelector<HTMLButtonElement>("[data-lightbox-close]");

  let opener: HTMLButtonElement | null = null;

  function openLightbox(thumb: HTMLButtonElement) {
    if (!dialog || !image || dialog.open) return;
    opener = thumb;
    image.src = thumb.dataset.fullSrc ?? "";
    image.width = Number(thumb.dataset.fullWidth) || 0;
    image.height = Number(thumb.dataset.fullHeight) || 0;
    image.alt = thumb.querySelector("img")?.alt ?? "";

    dialog.showModal();
    document.body.style.overflow = "hidden";
    closeBtn?.focus();
  }

  document.querySelectorAll<HTMLButtonElement>("[data-title-thumb]").forEach((thumb) => {
    thumb.addEventListener("click", () => openLightbox(thumb));
  });

  // Esc (nativo del <dialog>), X y click afuera terminan todos acá: el foco vuelve a la miniatura.
  dialog?.addEventListener("close", () => {
    document.body.style.overflow = "";
    opener?.focus();
    opener = null;
  });

  closeBtn?.addEventListener("click", () => dialog?.close());

  // Click afuera = sobre el backdrop (el propio <dialog>), no sobre la imagen.
  let pointerDownOutside = false;
  dialog?.addEventListener("pointerdown", (event) => {
    pointerDownOutside = event.target === dialog;
  });
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog && pointerDownOutside) dialog.close();
    pointerDownOutside = false;
  });

  // Foco atrapado: el único elemento enfocable adentro es la X, así que Tab y Shift+Tab se quedan ahí.
  dialog?.addEventListener("keydown", (event) => {
    if (event.key !== "Tab") return;
    event.preventDefault();
    closeBtn?.focus();
  });
</script>
