---
import { Image, Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import WaveDivider from "../components/WaveDivider.astro";
import ImageLightbox from "../components/ImageLightbox.astro";
import OrigenMark from "../components/OrigenMark.astro";
import { contact } from "../data/contact";
import crown from "../assets/logo2.png";
import { salonPhotos as salon } from "../data/salon";

// Fotos del salón: las 8 de data/salon.ts (con su texto alternativo), en este orden.
const salonPhotos = await Promise.all(
  [salon.cabina, salon.cabinaLed, salon.equipo, salon.vista, salon.tocador, salon.lavado, salon.noche, salon.rincon].map(async (photo) => ({
    ...photo,
    full: await getImage({ src: photo.image, format: "webp", width: 1280 }),
  })),
);

// Todos los títulos de src/assets/studies/titulo-N.jpg, ordenados por N (las claves del glob vienen
// en orden alfabético: titulo-10 antes que titulo-2). Para sumar uno nuevo alcanza con agregar el
// archivo siguiente; no hay que tocar este código.
const modules = import.meta.glob<{ default: ImageMetadata }>("../assets/studies/titulo-*.jpg", { eager: true });

const titles = await Promise.all(
  Object.entries(modules)
    .map(([path, mod]) => ({ num: Number(path.match(/titulo-(\d+)\.jpg$/)?.[1] ?? 0), image: mod.default }))
    .sort((a, b) => a.num - b.num)
    .map(async ({ image }, index) => ({
      image,
      alt: `Certificado ${index + 1} de ${contact.owner}`,
      // Versión grande para el lightbox (WebP; Astro no agranda si el original es más chico).
      full: await getImage({ src: image, format: "webp", width: 1280 }),
    })),
);

const thumbClass =
  "group block w-full cursor-pointer overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-rose-200 transition-shadow hover:shadow-md " +
  "focus-visible:ring-2 focus-visible:ring-rose-700 focus-visible:outline-none dark:bg-warmgray-800 dark:ring-warmgray-700 dark:focus-visible:ring-rose-300";
const thumbImgClass =
  "h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100";
---

<Layout
  title={`Sobre mí | ${contact.brand}`}
  description={`${contact.owner}, esteticista profesional y facilitadora de Constelaciones Familiares en San Salvador de Jujuy: ${contact.brand} y Volver al Origen.`}
>
  <Navbar />

  <main>
    {/* Encabezado oscuro: el Navbar es transparente con texto blanco, así que la página arranca
       sobre fondo oscuro igual que la home (video del Hero). */}
    <section
      class="relative overflow-hidden bg-gradient-to-br from-warmgray-900 via-warmgray-800 to-warmgray-900 px-4 pt-28 pb-24 text-center sm:px-6 sm:pt-36 md:pb-32 dark:from-black dark:via-warmgray-900 dark:to-black"
    >
      <div aria-hidden="true" class="pointer-events-none absolute -top-32 -left-24 h-72 w-72 rounded-full bg-rose-muted/20 blur-3xl"></div>
      <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-32 h-72 w-72 rounded-full bg-rose-muted-strong/15 blur-3xl"></div>

      <div class="relative z-10 mx-auto max-w-2xl">
        <p class="font-sans text-xs font-semibold tracking-widest text-rose-300 uppercase">Sobre mí</p>
        <h1 class="mt-2 font-display text-4xl text-white md:text-5xl">{contact.owner}</h1>

        <div class="mx-auto mt-6 space-y-4 font-sans leading-relaxed text-warmgray-100">
          <p>
            {contact.owner} es esteticista profesional y facilitadora de constelaciones familiares en San Salvador de Jujuy. Su
            propuesta une dos mundos que casi nadie junta: el cuidado del cuerpo y la conexión con el alma.
          </p>
          <p>
            En {contact.brand} ofrece faciales, corporales, depilación definitiva, masajes, pestañas y cejas, con una estética
            femenina, cálida y luminosa. Con «Volver al Origen» acompaña a las personas a mirar su historia familiar con amor, en
            talleres grupales.
          </p>
          <p class="pt-2 font-display text-xl leading-snug text-rose-200 italic md:text-2xl">
            Es una mujer que no solo embellece, sino que invita a cada clienta a sentirse reina, por fuera y por dentro.
          </p>
        </div>
      </div>

      <WaveDivider
        id="about-titles"
        color4="#FFF5F8"
        darkColor1="#a9697f"
        darkColor2="#c98ba0"
        darkColor3="#5c5049"
        darkColor4="#2b2422"
      />
    </section>

    {/* Las dos caras de la propuesta. */}
    <section class="bg-rose-50 px-3 pt-16 pb-8 sm:px-6 md:pt-20 dark:bg-warmgray-900">
      <h2 class="sr-only">Por fuera y por dentro</h2>
      <div class="mx-auto grid max-w-4xl gap-5 sm:grid-cols-2 sm:gap-6">
        <a
          href="/#skills"
          class="group flex flex-col items-center rounded-3xl border border-rose-200 bg-white p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-lg focus-visible:ring-2 focus-visible:ring-rose-700 focus-visible:outline-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-8 dark:border-warmgray-700 dark:bg-warmgray-800 dark:focus-visible:ring-rose-300"
        >
          <Image src={crown} width={56} densities={[1, 2]} alt="" aria-hidden="true" loading="lazy" class="h-14 w-14 object-contain" />
          <p class="mt-3 font-sans text-xs font-semibold tracking-[0.2em] text-rose-700 uppercase dark:text-rose-300">Por fuera</p>
          <h3 class="mt-1 font-display text-3xl text-warmgray-800 dark:text-warmgray-100">{contact.brand}</h3>
          <p class="mt-3 font-sans text-sm leading-relaxed text-warmgray-700 dark:text-warmgray-100">
            Faciales, corporales, depilación definitiva, masajes, pestañas y cejas.
          </p>
          <span class="mt-5 font-sans text-sm font-semibold text-rose-700 group-hover:underline dark:text-rose-300">
            Ver servicios <span aria-hidden="true">→</span>
          </span>
        </a>

        <a
          href="/#volver-al-origen"
          class="group flex flex-col items-center rounded-3xl border border-origen-watercolor/70 bg-origen-cream p-6 text-center shadow-sm transition hover:-translate-y-1 hover:shadow-lg focus-visible:ring-2 focus-visible:ring-origen-leaf-deep focus-visible:outline-none motion-reduce:transition-none motion-reduce:hover:translate-y-0 sm:p-8 dark:border-origen-gold/30 dark:bg-gradient-to-b dark:from-origen-night dark:to-origen-night-earth dark:focus-visible:ring-origen-gold"
        >
          <p class="font-sans text-xs font-semibold tracking-[0.2em] text-origen-leaf-deep uppercase dark:text-origen-gold">Por dentro</p>
          <div class="mt-2 w-full max-w-[16rem]">
            <OrigenMark as="h3" treeWidth={120} showMotto={false} size="sm" />
          </div>
          <p class="mt-2 font-sans text-sm leading-relaxed text-origen-ink-soft dark:text-origen-moon-soft">
            Talleres grupales de Constelaciones Familiares para mirar tu historia familiar con amor.
          </p>
          <span class="mt-5 font-sans text-sm font-semibold text-origen-leaf-deep group-hover:underline dark:text-origen-gold">
            Conocer más <span aria-hidden="true">→</span>
          </span>
        </a>
      </div>
    </section>

    <section id="salon" class="bg-rose-50 px-3 py-16 sm:px-6 md:py-20 dark:bg-warmgray-900">
      <div class="mx-auto max-w-6xl">
        <div class="mb-10 text-center md:mb-14">
          <p class="font-sans text-xs font-semibold tracking-widest text-rose-700 uppercase dark:text-rose-300">El salón</p>
          <h2 class="mt-2 font-display text-3xl text-warmgray-800 md:text-5xl dark:text-warmgray-100">Un espacio para vos</h2>
          <p class="mx-auto mt-3 max-w-xl font-sans text-warmgray-700 dark:text-warmgray-100">Tocá cualquier foto para verla en grande.</p>
        </div>

        <ul class="grid grid-cols-2 gap-2 sm:gap-4 md:grid-cols-4">
          {
            salonPhotos.map((photo) => (
              <li>
                <button
                  type="button"
                  data-lightbox-thumb
                  data-full-src={photo.full.src}
                  data-full-width={photo.full.attributes.width}
                  data-full-height={photo.full.attributes.height}
                  aria-haspopup="dialog"
                  class={thumbClass}
                >
                  <Picture
                    src={photo.image}
                    formats={["avif"]}
                    fallbackFormat="webp"
                    widths={[200, 320, 480, 640]}
                    sizes="(min-width: 1152px) 276px, (min-width: 768px) 25vw, 50vw"
                    alt={photo.alt}
                    loading="lazy"
                    class={`aspect-[4/3] ${thumbImgClass}`}
                  />
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="titulos" class="bg-rose-50 px-3 pt-4 pb-16 sm:px-6 md:pb-24 dark:bg-warmgray-900">
      <div class="mx-auto max-w-6xl">
        <div class="mb-10 text-center md:mb-14">
          <p class="font-sans text-xs font-semibold tracking-widest text-rose-700 uppercase dark:text-rose-300">Formación</p>
          <h2 class="mt-2 font-display text-3xl text-warmgray-800 md:text-5xl dark:text-warmgray-100">Títulos y certificaciones</h2>
          <p class="mx-auto mt-3 max-w-xl font-sans text-warmgray-700 dark:text-warmgray-100">Tocá cualquier título para verlo en grande.</p>
        </div>

        <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 sm:gap-4 md:grid-cols-4 lg:grid-cols-5">
          {
            titles.map((title) => (
              <li>
                <button
                  type="button"
                  data-lightbox-thumb
                  data-full-src={title.full.src}
                  data-full-width={title.full.attributes.width}
                  data-full-height={title.full.attributes.height}
                  aria-haspopup="dialog"
                  class={thumbClass}
                >
                  <Picture
                    src={title.image}
                    formats={["avif"]}
                    fallbackFormat="webp"
                    widths={[160, 240, 320, 480]}
                    sizes="(min-width: 1024px) 220px, (min-width: 768px) 25vw, (min-width: 640px) 33vw, 50vw"
                    alt={title.alt}
                    loading="lazy"
                    class={`aspect-[3/4] ${thumbImgClass}`}
                  />
                </button>
              </li>
            ))
          }
        </ul>
      </div>
    </section>
  </main>

  <Footer />
  <ImageLightbox />
</Layout>
