---
import { skillCategories } from "../data/skills";
import logo from "../assets/logo.png";

import { contact, phoneHref, buildWhatsAppUrl } from "../data/contact";

const { address, phoneDisplay, hours, mapEmbedUrl } = contact;

const hoverClasses: Record<string, string> = {
  Instagram: "hover:text-[#e1306c]",
  Facebook: "hover:text-[#1877f2]",
  WhatsApp: "hover:text-[#25d366]",
  TikTok: "hover:text-[#25f4ee]",
};

// Solo se muestran las redes que tienen URL cargada en data/contact.ts (nada de href="#").
// WhatsApp va siempre, armado con el número del salón.
const socialLinks = [
  ...contact.socials.filter((social) => social.url.trim() !== ""),
  { name: "WhatsApp", url: buildWhatsAppUrl(`Hola ${contact.brand}, quiero hacer una consulta.`) },
].map((social) => ({ ...social, hoverClass: hoverClasses[social.name] }));
---

<footer
  id="contact"
  class="relative overflow-hidden bg-gradient-to-br from-warmgray-900 via-warmgray-800 to-warmgray-900 px-3 py-16 text-warmgray-100 sm:px-6 md:py-24 dark:from-black dark:via-warmgray-900 dark:to-black"
>
  {/* Acentos decorativos: rosado apagado, consistente con la identidad de marca en modo oscuro */}
  <div aria-hidden="true" class="pointer-events-none absolute -top-32 -left-24 h-72 w-72 rounded-full bg-rose-muted/20 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-32 h-72 w-72 rounded-full bg-rose-muted-strong/15 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      {/* Columna izquierda: logo + formulario */}
      <div>
        <img src={logo.src} width={logo.width} height={logo.height} alt="Estética Reina" class="h-16 w-auto rounded-xl" />

        <h3 class="mt-6 font-display text-2xl text-warmgray-100 sm:text-3xl">Escribinos</h3>
        <p class="mt-1 font-sans text-sm text-warmgray-300">Contanos qué necesitás y te respondemos a la brevedad.</p>

        <form data-contact-form class="mt-6 space-y-4" novalidate>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="contact-name" class="mb-1.5 block font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">
                Nombre y apellido
              </label>
              <input
                id="contact-name"
                name="fullName"
                type="text"
                required
                autocomplete="name"
                class="w-full rounded-lg border border-white/15 bg-white/10 px-4 py-2.5 font-sans text-sm text-white placeholder:text-warmgray-400 outline-none transition-colors focus:border-rose-300 focus:bg-white/15 focus:ring-2 focus:ring-rose-400/40"
                placeholder="Ana Pérez"
              />
            </div>

            <div>
              <label for="contact-email" class="mb-1.5 block font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">
                Email
              </label>
              <input
                id="contact-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                class="w-full rounded-lg border border-white/15 bg-white/10 px-4 py-2.5 font-sans text-sm text-white placeholder:text-warmgray-400 outline-none transition-colors focus:border-rose-300 focus:bg-white/15 focus:ring-2 focus:ring-rose-400/40"
                placeholder="ana@email.com"
              />
            </div>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="contact-phone" class="mb-1.5 block font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">
                Teléfono
              </label>
              <input
                id="contact-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                class="w-full rounded-lg border border-white/15 bg-white/10 px-4 py-2.5 font-sans text-sm text-white placeholder:text-warmgray-400 outline-none transition-colors focus:border-rose-300 focus:bg-white/15 focus:ring-2 focus:ring-rose-400/40"
                placeholder="+54 9 ..."
              />
            </div>

            <div>
              <label for="contact-service" class="mb-1.5 block font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">
                Servicio de interés
              </label>
              <select
                id="contact-service"
                name="service"
                required
                class="w-full rounded-lg border border-white/15 bg-white/10 px-4 py-2.5 font-sans text-sm text-white outline-none transition-colors focus:border-rose-300 focus:bg-white/15 focus:ring-2 focus:ring-rose-400/40"
              >
                <option value="" disabled selected class="text-warmgray-800">
                  Elegí una opción
                </option>
                {
                  skillCategories.map((category) => (
                    <option value={category.id} class="text-warmgray-800">
                      {category.title}
                    </option>
                  ))
                }
              </select>
            </div>
          </div>

          <div>
            <label for="contact-message" class="mb-1.5 block font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">
              Mensaje / detalles
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              class="w-full resize-none rounded-lg border border-white/15 bg-white/10 px-4 py-2.5 font-sans text-sm text-white placeholder:text-warmgray-400 outline-none transition-colors focus:border-rose-300 focus:bg-white/15 focus:ring-2 focus:ring-rose-400/40"
              placeholder="Contanos qué estás buscando..."
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-full bg-rose-500 px-6 py-3 font-sans text-sm font-semibold text-white transition-colors hover:bg-rose-600 dark:hover:bg-rose-muted-strong"
          >
            Enviar mensaje
          </button>

          <div
            data-form-toast
            role="status"
            class="toast-message hidden items-center gap-2 rounded-lg border border-rose-300/30 bg-rose-400/15 px-4 py-3 font-sans text-sm text-rose-100"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 shrink-0">
              <path
                fill-rule="evenodd"
                d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                clip-rule="evenodd"
              />
            </svg>
            <span>¡Gracias! Recibimos tu mensaje y te vamos a contactar a la brevedad.</span>
          </div>
        </form>
      </div>

      {/* Columna derecha: mapa + datos de contacto + redes */}
      <div class="flex flex-col gap-8">
        <iframe
          src={mapEmbedUrl}
          class="h-64 w-full rounded-2xl border border-white/10 grayscale transition-all duration-500 hover:grayscale-0 sm:h-72"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Ubicación de Estética Reina en el mapa"
        >
        </iframe>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          <div class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-rose-300">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z" />
                <circle cx="12" cy="9.5" r="2.5" />
              </svg>
            </span>
            <div>
              <p class="font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">Dirección</p>
              <p class="mt-0.5 font-sans text-sm text-warmgray-100">{address}</p>
            </div>
          </div>

          <div class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-rose-300">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path d="M6.5 3.5h3l1.3 3.8-1.9 1.9c.9 2.3 2.7 4.1 5 5l1.9-1.9 3.8 1.3v3c0 .9-.8 1.7-1.7 1.6-8-.5-13.9-6.4-14.4-14.4-.1-.9.7-1.7 1.6-1.7z" />
              </svg>
            </span>
            <div>
              <p class="font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">Teléfono</p>
              <a href={phoneHref} class="mt-0.5 block font-sans text-sm text-warmgray-100 transition-colors hover:text-rose-300">
                {phoneDisplay}
              </a>
            </div>
          </div>

          <div class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-rose-300">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7.5V12l3 2" />
              </svg>
            </span>
            <div>
              <p class="font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">Horario</p>
              <p class="mt-0.5 font-sans text-sm text-warmgray-100">{hours}</p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-center gap-4 sm:justify-start">
          {
            socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${social.name} (se abre en una pestaña nueva)`}
                class={`flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/10 text-warmgray-200 transition-all duration-300 hover:-translate-y-1 hover:border-white/0 ${social.hoverClass}`}
              >
                {social.name === "Instagram" && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {social.name === "Facebook" && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
                    <circle cx="12" cy="12" r="9" />
                    <path
                      fill="currentColor"
                      stroke="none"
                      d="M13.3 8.6h1.4V6.2h-1.8c-1.5 0-2.7 1.2-2.7 2.7v1.3H8.8v2.1h1.4v5.7h2.2v-5.7h1.8l.3-2.1h-2.1V9c0-.2.2-.4.4-.4z"
                    />
                  </svg>
                )}
                {social.name === "WhatsApp" && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M12 2.5a9.5 9.5 0 00-8.2 14.3L2.5 21l4.3-1.3A9.5 9.5 0 1012 2.5zm5.3 13.4c-.2.6-1.3 1.2-1.8 1.3-.5.1-1 .2-3.2-.7-2.7-1.1-4.5-3.8-4.6-4-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .5.4.2.5.7 1.6.7 1.7.1.1.1.3 0 .4-.1.2-.1.3-.3.4-.1.2-.3.3-.4.5-.2.2-.4.4-.2.7.3.5.9 1.3 1.7 2 .9.8 1.7 1.1 2.1 1.3.2.1.4.1.6-.1.2-.2.6-.7.8-1 .2-.3.4-.2.6-.1l1.6.8c.2.1.3.2.4.3.1.1.1.8-.1 1.4z" />
                  </svg>
                )}
                {social.name === "TikTok" && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M14.5 3c.3 1.7 1.4 3 3.1 3.3v2.4c-1.2 0-2.2-.4-3.1-1v6.5a4.4 4.4 0 11-4.4-4.4c.3 0 .6 0 .9.1v2.4a2 2 0 102 2V3h1.5z" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-6 text-center font-sans text-xs text-warmgray-400">
      © Estética Reina 2026. Todos los derechos reservados.
    </div>
  </div>
</footer>

<style>
  .toast-message {
    display: none;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 300ms ease-out,
      transform 300ms ease-out;
  }

  .toast-message.is-visible {
    display: flex;
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const toast = document.querySelector<HTMLElement>("[data-form-toast]");

  let hideTimer: ReturnType<typeof setTimeout> | undefined;

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const data = new FormData(form);
    const payload = Object.fromEntries(data.entries());

    // TODO: conectar con el backend real. Por ahora solo lo dejamos en consola.
    console.log("Nuevo mensaje de contacto:", payload);

    form.reset();

    if (toast) {
      toast.classList.remove("hidden");
      // Fuerza reflow para que el estado inicial (opacity:0) pinte antes de animar
      void toast.offsetWidth;
      toast.classList.add("is-visible");

      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => {
        toast.classList.remove("is-visible");
      }, 4500);
    }
  });
</script>
