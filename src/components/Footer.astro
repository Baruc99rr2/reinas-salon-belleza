---
import { Image } from "astro:assets";
import logo from "../assets/logo.png";

import { contact, phoneHref, buildWhatsAppUrl } from "../data/contact";

const { address, phoneDisplay, hours, mapEmbedUrl } = contact;

const hoverClasses: Record<string, string> = {
  Instagram: "hover:text-[#e1306c]",
  Facebook: "hover:text-[#1877f2]",
  WhatsApp: "hover:text-[#25d366]",
  TikTok: "hover:text-[#25f4ee]",
};

// Solo se muestran las redes que tienen URL cargada en data/contact.ts (nada de href="#").
// WhatsApp va siempre, armado con el número del salón.
const socialLinks = [
  ...contact.socials.filter((social) => social.url.trim() !== ""),
  { name: "WhatsApp", url: buildWhatsAppUrl(`Hola ${contact.brand}, quiero hacer una consulta.`) },
].map((social) => ({ ...social, hoverClass: hoverClasses[social.name] }));
---

<footer
  id="contact"
  class="relative overflow-hidden bg-gradient-to-br from-warmgray-900 via-warmgray-800 to-warmgray-900 px-3 py-16 text-warmgray-100 sm:px-6 md:py-24 dark:from-black dark:via-warmgray-900 dark:to-black"
>
  {/* Acentos decorativos: rosado apagado, consistente con la identidad de marca en modo oscuro */}
  <div aria-hidden="true" class="pointer-events-none absolute -top-32 -left-24 h-72 w-72 rounded-full bg-rose-muted/20 blur-3xl"></div>
  <div aria-hidden="true" class="pointer-events-none absolute -right-24 -bottom-32 h-72 w-72 rounded-full bg-rose-muted-strong/15 blur-3xl"></div>

  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="grid gap-12 md:grid-cols-2 md:gap-16">
      {/* Columna izquierda: logo + formulario */}
      <div>
        <Image src={logo} width={64} densities={[1, 2]} alt={contact.brand} loading="lazy" class="h-16 w-auto rounded-xl" />

        <h3 class="mt-6 font-display text-2xl text-warmgray-100 sm:text-3xl">Escribinos</h3>
        <p class="mt-1 font-sans text-sm text-warmgray-100">Contanos qué necesitás y te abrimos WhatsApp con tu mensaje listo para enviar.</p>

        {/* Formulario real: valida nombre y mensaje y abre WhatsApp con "Hola, soy <nombre>. <mensaje>".
           novalidate porque los mensajes de error los mostramos nosotros (visibles y en español). */}
        <form data-contact-form class="mt-6 space-y-4" novalidate>
          <div>
            <label for="contact-name" class="mb-1.5 block font-sans text-xs font-semibold tracking-wide text-warmgray-100 uppercase">
              Nombre y apellido
            </label>
            <input
              id="contact-name"
              name="fullName"
              type="text"
              required
              autocomplete="name"
              aria-describedby="contact-name-error"
              class="w-full rounded-lg border border-white/15 bg-white/10 px-4 py-2.5 font-sans text-sm text-white placeholder:text-warmgray-400 outline-none transition-colors focus:border-rose-300 focus:bg-white/15 focus:ring-2 focus:ring-rose-400/40 aria-[invalid=true]:border-rose-300"
              placeholder="Ana Pérez"
            />
            <p id="contact-name-error" data-error-for="contact-name" hidden class="mt-1.5 font-sans text-xs font-medium text-rose-300">
              Ingresá tu nombre.
            </p>
          </div>

          <div>
            <label for="contact-message" class="mb-1.5 block font-sans text-xs font-semibold tracking-wide text-warmgray-100 uppercase">
              Mensaje / consulta
            </label>
            <textarea
              id="contact-message"
              name="message"
              rows="4"
              required
              aria-describedby="contact-message-error"
              class="w-full resize-none rounded-lg border border-white/15 bg-white/10 px-4 py-2.5 font-sans text-sm text-white placeholder:text-warmgray-400 outline-none transition-colors focus:border-rose-300 focus:bg-white/15 focus:ring-2 focus:ring-rose-400/40 aria-[invalid=true]:border-rose-300"
              placeholder="Contanos qué estás buscando..."></textarea>
            <p id="contact-message-error" data-error-for="contact-message" hidden class="mt-1.5 font-sans text-xs font-medium text-rose-300">
              Escribí tu mensaje o consulta.
            </p>
          </div>

          <button
            type="submit"
            class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-rose-700 px-6 py-3 font-sans text-sm font-semibold text-white transition hover:brightness-110 focus-visible:ring-2 focus-visible:ring-rose-300 focus-visible:ring-offset-2 focus-visible:ring-offset-warmgray-900 focus-visible:outline-none"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
              <path
                d="M12 2.5a9.5 9.5 0 00-8.2 14.3L2.5 21l4.3-1.3A9.5 9.5 0 1012 2.5zm5.3 13.4c-.2.6-1.3 1.2-1.8 1.3-.5.1-1 .2-3.2-.7-2.7-1.1-4.5-3.8-4.6-4-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .5.4.2.5.7 1.6.7 1.7.1.1.1.3 0 .4-.1.2-.1.3-.3.4-.1.2-.3.3-.4.5-.2.2-.4.4-.2.7.3.5.9 1.3 1.7 2 .9.8 1.7 1.1 2.1 1.3.2.1.4.1.6-.1.2-.2.6-.7.8-1 .2-.3.4-.2.6-.1l1.6.8c.2.1.3.2.4.3.1.1.1.8-.1 1.4z"
              ></path>
            </svg>
            Enviar por WhatsApp
          </button>

          {/* Aviso honesto: no dice que el mensaje "se recibió" (eso pasa recién cuando la clienta lo
             envía en WhatsApp), y deja un link de respaldo por si el navegador bloqueó la pestaña. */}
          <p data-contact-status role="status" class="font-sans text-sm text-warmgray-100" hidden>
            Abrimos WhatsApp en una pestaña nueva con tu mensaje. Para que nos llegue, tocá “Enviar” en WhatsApp.
            ¿No se abrió? <a data-contact-fallback href="" target="_blank" rel="noopener noreferrer" class="font-semibold text-rose-300 underline underline-offset-2">Abrir WhatsApp</a>
          </p>
        </form>
      </div>

      {/* Columna derecha: mapa + datos de contacto + redes */}
      <div class="flex flex-col gap-8">
        <iframe
          src={mapEmbedUrl}
          class="h-64 w-full rounded-2xl border border-white/10 grayscale transition-all duration-500 hover:grayscale-0 sm:h-72"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title={`Ubicación de ${contact.brand} en el mapa`}
        >
        </iframe>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
          <div class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-rose-300">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z" />
                <circle cx="12" cy="9.5" r="2.5" />
              </svg>
            </span>
            <div>
              <p class="font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">Dirección</p>
              <p class="mt-0.5 font-sans text-sm text-warmgray-100">{address}</p>
            </div>
          </div>

          <div class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-rose-300">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <path d="M6.5 3.5h3l1.3 3.8-1.9 1.9c.9 2.3 2.7 4.1 5 5l1.9-1.9 3.8 1.3v3c0 .9-.8 1.7-1.7 1.6-8-.5-13.9-6.4-14.4-14.4-.1-.9.7-1.7 1.6-1.7z" />
              </svg>
            </span>
            <div>
              <p class="font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">Teléfono</p>
              <a href={phoneHref} class="mt-0.5 block font-sans text-sm text-warmgray-100 transition-colors hover:text-rose-300">
                {phoneDisplay}
              </a>
            </div>
          </div>

          <div class="flex flex-col items-center gap-2 text-center sm:items-start sm:text-left">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-rose-300">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5">
                <circle cx="12" cy="12" r="9" />
                <path d="M12 7.5V12l3 2" />
              </svg>
            </span>
            <div>
              <p class="font-sans text-xs font-semibold tracking-wide text-warmgray-300 uppercase">Horario</p>
              <p class="mt-0.5 font-sans text-sm text-warmgray-100">{hours}</p>
            </div>
          </div>
        </div>

        <div class="flex items-center justify-center gap-4 sm:justify-start">
          {
            socialLinks.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${social.name} (se abre en una pestaña nueva)`}
                class={`flex h-11 w-11 items-center justify-center rounded-full border border-white/15 bg-white/10 text-warmgray-200 transition-all duration-300 hover:-translate-y-1 hover:border-white/0 ${social.hoverClass}`}
              >
                {social.name === "Instagram" && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-5 w-5">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {social.name === "Facebook" && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="h-5 w-5">
                    <circle cx="12" cy="12" r="9" />
                    <path
                      fill="currentColor"
                      stroke="none"
                      d="M13.3 8.6h1.4V6.2h-1.8c-1.5 0-2.7 1.2-2.7 2.7v1.3H8.8v2.1h1.4v5.7h2.2v-5.7h1.8l.3-2.1h-2.1V9c0-.2.2-.4.4-.4z"
                    />
                  </svg>
                )}
                {social.name === "WhatsApp" && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M12 2.5a9.5 9.5 0 00-8.2 14.3L2.5 21l4.3-1.3A9.5 9.5 0 1012 2.5zm5.3 13.4c-.2.6-1.3 1.2-1.8 1.3-.5.1-1 .2-3.2-.7-2.7-1.1-4.5-3.8-4.6-4-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .5.4.2.5.7 1.6.7 1.7.1.1.1.3 0 .4-.1.2-.1.3-.3.4-.1.2-.3.3-.4.5-.2.2-.4.4-.2.7.3.5.9 1.3 1.7 2 .9.8 1.7 1.1 2.1 1.3.2.1.4.1.6-.1.2-.2.6-.7.8-1 .2-.3.4-.2.6-.1l1.6.8c.2.1.3.2.4.3.1.1.1.8-.1 1.4z" />
                  </svg>
                )}
                {social.name === "TikTok" && (
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5">
                    <path d="M14.5 3c.3 1.7 1.4 3 3.1 3.3v2.4c-1.2 0-2.2-.4-3.1-1v6.5a4.4 4.4 0 11-4.4-4.4c.3 0 .6 0 .9.1v2.4a2 2 0 102 2V3h1.5z" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <div class="mt-12 border-t border-white/10 pt-6 text-center font-sans text-xs text-warmgray-400">
      © {contact.brand} 2026. Todos los derechos reservados.
    </div>
  </div>
</footer>

<script>
  import { buildWhatsAppUrl } from "../data/contact";
  import { buildContactMessage } from "../lib/booking";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  const nameInput = document.querySelector<HTMLInputElement>("#contact-name");
  const messageInput = document.querySelector<HTMLTextAreaElement>("#contact-message");
  const status = document.querySelector<HTMLElement>("[data-contact-status]");
  const fallbackLink = document.querySelector<HTMLAnchorElement>("[data-contact-fallback]");

  function setError(field: HTMLInputElement | HTMLTextAreaElement, hasError: boolean) {
    field.setAttribute("aria-invalid", String(hasError));
    const error = document.querySelector<HTMLElement>(`[data-error-for="${field.id}"]`);
    if (error) error.hidden = !hasError;
  }

  // El error se borra apenas la clienta corrige el campo (no hace falta volver a enviar para verlo irse).
  [nameInput, messageInput].forEach((field) => {
    field?.addEventListener("input", () => {
      if (field.value.trim() !== "") setError(field, false);
    });
  });

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    if (!nameInput || !messageInput) return;

    const nameOk = nameInput.value.trim() !== "";
    const messageOk = messageInput.value.trim() !== "";
    setError(nameInput, !nameOk);
    setError(messageInput, !messageOk);

    if (!nameOk || !messageOk) {
      if (status) status.hidden = true;
      (nameOk ? messageInput : nameInput).focus();
      return;
    }

    const url = buildWhatsAppUrl(buildContactMessage(nameInput.value, messageInput.value));
    window.open(url, "_blank", "noopener");

    if (fallbackLink) fallbackLink.href = url;
    if (status) status.hidden = false;
    form.reset();
  });
</script>
