---
interface Props {
  /** Identificador único de esta instancia: evita que el <path> de una instancia choque (mismo
   * id) con el de otra instancia de este mismo componente en la página. */
  id: string;
  color1?: string;
  color2?: string;
  color3?: string;
  color4?: string;
  darkColor1?: string;
  darkColor2?: string;
  darkColor3?: string;
  darkColor4?: string;
}

const {
  id,
  color1 = "#F7B2CB",
  color2 = "#F28FB2",
  color3 = "#FBD3E0",
  color4 = "#FFF5F8",
  darkColor1 = color1,
  darkColor2 = color2,
  darkColor3 = color3,
  darkColor4 = color4,
} = Astro.props;

const waveId = `gentle-wave-${id}`;
---

<div
  class="editorial"
  aria-hidden="true"
  style={`--wave-color-1:${color1};--wave-color-2:${color2};--wave-color-3:${color3};--wave-color-4:${color4};--wave-color-1-dark:${darkColor1};--wave-color-2-dark:${darkColor2};--wave-color-3-dark:${darkColor3};--wave-color-4-dark:${darkColor4};`}
>
  <svg viewBox="0 24 150 28" preserveAspectRatio="none" class="waves-svg">
    <defs>
      <path id={waveId} d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z"></path>
    </defs>
    <g class="parallax">
      <use href={`#${waveId}`} x="48" y="0" class="wave wave1"></use>
      <use href={`#${waveId}`} x="48" y="3" class="wave wave2"></use>
      <use href={`#${waveId}`} x="48" y="5" class="wave wave3"></use>
      <use href={`#${waveId}`} x="48" y="7" class="wave wave4"></use>
    </g>
  </svg>
</div>

<style>
  .editorial {
    display: block;
    width: 100%;
    height: 60px;
    max-height: 60px;
    margin: 0;
    z-index: 10;
    bottom: 0;
    position: absolute;
    left: 0;
    overflow: hidden;
  }

  .waves-svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .wave1 {
    fill: var(--wave-color-1);
  }
  .wave2 {
    fill: var(--wave-color-2);
  }
  .wave3 {
    fill: var(--wave-color-3);
  }
  .wave4 {
    fill: var(--wave-color-4);
  }

  :global(.dark) .wave1 {
    fill: var(--wave-color-1-dark);
  }
  :global(.dark) .wave2 {
    fill: var(--wave-color-2-dark);
  }
  :global(.dark) .wave3 {
    fill: var(--wave-color-3-dark);
  }
  :global(.dark) .wave4 {
    fill: var(--wave-color-4-dark);
  }

  .wave1 {
    animation: move-forever1 7s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
    animation-delay: -2s;
  }
  .wave2 {
    animation: move-forever2 10s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
    animation-delay: -3s;
  }
  .wave3 {
    animation: move-forever3 13s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
    animation-delay: -4s;
  }
  .wave4 {
    animation: move-forever4 20s cubic-bezier(0.55, 0.5, 0.45, 0.5) infinite;
    animation-delay: -5s;
  }

  @keyframes move-forever1 {
    0% {
      transform: translate3d(-90px, 0, 0);
    }
    100% {
      transform: translate3d(85px, 0, 0);
    }
  }
  @keyframes move-forever2 {
    0% {
      transform: translate3d(-90px, 0, 0);
    }
    100% {
      transform: translate3d(85px, 0, 0);
    }
  }
  @keyframes move-forever3 {
    0% {
      transform: translate3d(-90px, 0, 0);
    }
    100% {
      transform: translate3d(85px, 0, 0);
    }
  }
  @keyframes move-forever4 {
    0% {
      transform: translate3d(-90px, 0, 0);
    }
    100% {
      transform: translate3d(85px, 0, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wave {
      animation: none;
    }
  }
</style>
