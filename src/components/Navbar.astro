---
import logoFull from "../assets/logo.png";
import logoCrest from "../assets/logo2.png";
import { contact } from "../data/contact";

// "Sobre mí" es una página aparte (/sobre-mi); el resto son anclas de la home, con barra
// inicial (/#seccion en vez de #seccion) para que funcionen igual estando en /sobre-mi.
const navLinks = [
  { label: "Inicio", href: "/#hero" },
  { label: "Sobre mí", href: "/sobre-mi" },
  { label: "Mis habilidades", href: "/#skills" },
  { label: "Precios", href: "/#pricing" },
  { label: "Contacto", href: "/#contact" },
];

const desktopLinkClass =
  "relative inline-block py-1 transition-colors " +
  "after:absolute after:-bottom-0.5 after:left-0 after:h-0.5 after:w-0 after:bg-rose-500 " +
  "after:transition-all after:duration-300 after:ease-out " +
  "hover:text-rose-600 hover:after:w-full active:after:w-full " +
  "dark:hover:text-rose-400 dark:after:bg-rose-400";

const mobileLinkClass =
  "relative block rounded-md px-2 py-3 transition-colors " +
  "after:absolute after:bottom-1 after:left-2 after:h-0.5 after:w-0 after:bg-rose-500 " +
  "after:transition-all after:duration-300 after:ease-out " +
  "hover:text-rose-600 hover:after:w-[calc(100%-1rem)] active:after:w-[calc(100%-1rem)] " +
  "dark:hover:text-rose-400 dark:after:bg-rose-400";
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 bg-white/10 shadow-sm backdrop-blur-sm dark:bg-warmgray-900/10"
>
  <nav class="mx-auto flex max-w-6xl items-center justify-between gap-2 px-3 py-3 sm:px-6 sm:py-4">
    <a
      href="/#hero"
      aria-label={`${contact.brand} — Inicio`}
      class="relative flex h-10 min-w-0 shrink items-center sm:h-14 md:h-16"
    >
      <img
        id="logo-full"
        src={logoFull.src}
        width={logoFull.width}
        height={logoFull.height}
        alt={`${contact.brand} — ${contact.tagline}`}
        class="h-auto max-h-10 w-auto max-w-[42vw] sm:max-h-14 sm:max-w-[220px] md:max-h-16 md:max-w-none"
      />
      <img
        id="logo-crest"
        src={logoCrest.src}
        width={logoCrest.width}
        height={logoCrest.height}
        alt={contact.brand}
        class="absolute left-0 h-auto max-h-8 w-auto max-w-[30vw] opacity-0 sm:max-h-10 sm:max-w-[160px] md:max-h-12 md:max-w-none"
      />
    </a>

    <div class="flex shrink-0 items-center gap-1.5 sm:gap-4">
      {/* Texto blanco fijo (no dark:): el navbar es fixed y flota sobre el video/las imágenes
         de fondo de cada sección al hacer scroll, nunca sobre un fondo sólido propio, así que
         necesita el mismo contraste en ambos temas en vez de invertirse con el tema activo. */}
      <ul class="hidden items-center gap-8 font-sans text-sm text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.45)] md:flex">
        {
          navLinks.map((link) => (
            <li>
              <a href={link.href} class={desktopLinkClass}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        id="theme-toggle"
        type="button"
        role="switch"
        aria-checked="false"
        aria-label="Cambiar a modo oscuro"
        class="relative flex h-6 w-11 shrink-0 items-center rounded-full border border-rose-200 bg-rose-50 p-1 transition-colors duration-300 sm:h-7 sm:w-14 dark:border-warmgray-800 dark:bg-warmgray-800"
      >
        <span
          id="theme-thumb"
          class="flex h-4 w-4 items-center justify-center rounded-full bg-white text-rose-500 shadow-sm transition-transform duration-300 dark:translate-x-5 sm:h-5 sm:w-5 sm:dark:translate-x-7 dark:bg-warmgray-900 dark:text-rose-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-3 w-3 sm:h-3.5 sm:w-3.5 dark:hidden">
            <circle cx="12" cy="12" r="4" />
            <path stroke-linecap="round" d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="hidden h-3 w-3 sm:h-3.5 sm:w-3.5 dark:block">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
          </svg>
        </span>
      </button>

      <button
        id="nav-toggle"
        type="button"
        aria-label="Abrir menú de navegación"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full bg-warmgray-900/60 text-white shadow-sm backdrop-blur-sm transition-colors hover:bg-warmgray-900/75 focus-visible:ring-2 focus-visible:ring-rose-300 focus-visible:outline-none sm:h-10 sm:w-10 md:hidden"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </nav>

  <ul
    id="mobile-menu"
    class="hidden flex-col gap-1 border-t border-rose-100 bg-white px-4 py-3 font-sans text-sm text-warmgray-800 sm:px-6 sm:py-4 md:hidden dark:border-warmgray-800 dark:bg-warmgray-900 dark:text-warmgray-100"
  >
    {
      navLinks.map((link) => (
        <li>
          <a href={link.href} class={mobileLinkClass}>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<style>
  #logo-full,
  #logo-crest {
    transition: all 500ms ease-in-out;
  }

  #logo-crest {
    top: 50%;
    transform: translateY(-50%) scale(0.85);
  }

  #site-header.is-scrolled #logo-full {
    opacity: 0;
    transform: scale(0.9);
    pointer-events: none;
  }

  #site-header.is-scrolled #logo-crest {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  #site-header nav {
    transition: padding-block 500ms ease-in-out;
  }

  #site-header.is-scrolled nav {
    padding-block: 0.5rem;
  }

  /* Animación stagger de los links al desplegar el menú mobile */
  #mobile-menu li {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 350ms ease-out,
      transform 350ms ease-out;
  }

  #mobile-menu.is-open li {
    opacity: 1;
    transform: translateY(0);
  }

  #mobile-menu.is-open li:nth-child(1) {
    transition-delay: 0ms;
  }
  #mobile-menu.is-open li:nth-child(2) {
    transition-delay: 60ms;
  }
  #mobile-menu.is-open li:nth-child(3) {
    transition-delay: 120ms;
  }
  #mobile-menu.is-open li:nth-child(4) {
    transition-delay: 180ms;
  }
  #mobile-menu.is-open li:nth-child(5) {
    transition-delay: 240ms;
  }
  #mobile-menu.is-open li:nth-child(6) {
    transition-delay: 300ms;
  }
</style>

<script>
  // --- Menú mobile ---
  const toggleButton = document.getElementById("nav-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  function openMobileMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove("hidden");
    // Fuerza reflow para que el estado inicial (opacity:0) pinte antes de animar
    void mobileMenu.offsetWidth;
    mobileMenu.classList.add("is-open");
    toggleButton?.setAttribute("aria-expanded", "true");
    iconOpen?.classList.add("hidden");
    iconClose?.classList.remove("hidden");
  }

  function closeMobileMenu() {
    if (!mobileMenu) return;
    mobileMenu.classList.remove("is-open");
    mobileMenu.classList.add("hidden");
    toggleButton?.setAttribute("aria-expanded", "false");
    iconOpen?.classList.remove("hidden");
    iconClose?.classList.add("hidden");
  }

  toggleButton?.addEventListener("click", () => {
    if (mobileMenu?.classList.contains("hidden")) {
      openMobileMenu();
    } else {
      closeMobileMenu();
    }
  });

  mobileMenu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", closeMobileMenu);
  });

  // --- Logo compacto al hacer scroll: un solo booleano (isScrolled) con un único
  // umbral. El listener solo vuelve a tocar el DOM cuando ese booleano cambia de
  // valor (classList.toggle es un no-op si ya está en ese estado), nunca en cada
  // pixel de scroll; la transición visual la maneja el CSS de arriba.
  const header = document.getElementById("site-header");
  const SCROLL_THRESHOLD = 50;
  let isScrolled = false;
  let scrollTicking = false;

  function updateScrolledState() {
    const shouldBeScrolled = window.scrollY > SCROLL_THRESHOLD;
    if (shouldBeScrolled !== isScrolled) {
      isScrolled = shouldBeScrolled;
      header?.classList.toggle("is-scrolled", isScrolled);
    }
    scrollTicking = false;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (!scrollTicking) {
        scrollTicking = true;
        requestAnimationFrame(updateScrolledState);
      }
    },
    { passive: true },
  );
  updateScrolledState();

  // --- Toggle de modo claro/oscuro: barrido izquierda -> derecha vía View Transitions API ---
  // El navegador capta un snapshot del estado anterior y renderiza el nuevo en vivo;
  // nosotros solo animamos cómo se revela ese nuevo estado (ver @keyframes theme-sweep-reveal
  // en global.css). Ambos temas quedan visibles a la vez, sin duplicar el DOM.
  const root = document.documentElement;
  const themeToggle = document.getElementById("theme-toggle");

  function syncToggleState() {
    const isDark = root.classList.contains("dark");
    themeToggle?.setAttribute("aria-checked", String(isDark));
    themeToggle?.setAttribute("aria-label", isDark ? "Cambiar a modo claro" : "Cambiar a modo oscuro");
  }
  syncToggleState();

  function applyTheme(goingDark: boolean) {
    root.classList.toggle("dark", goingDark);
    localStorage.setItem("theme", goingDark ? "dark" : "light");
    syncToggleState();
  }

  type ViewTransition = { ready: Promise<void> };
  type ViewTransitionDocument = Document & {
    startViewTransition?: (callback: () => void) => ViewTransition;
  };

  themeToggle?.addEventListener("click", () => {
    const goingDark = !root.classList.contains("dark");
    const doc = document as ViewTransitionDocument;

    if (!doc.startViewTransition) {
      applyTheme(goingDark);
      return;
    }

    // `ready` puede rechazar si la transición se aborta (p. ej. clics muy
    // seguidos); el tema ya se aplicó igual, así que solo evitamos el
    // unhandled rejection en consola.
    doc.startViewTransition(() => applyTheme(goingDark)).ready.catch(() => {});
  });
</script>
