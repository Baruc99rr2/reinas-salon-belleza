---
import bgVideo from "../assets/bg-hero.mp4";
import WaveDivider from "./WaveDivider.astro";
import { contact, phoneHref } from "../data/contact";

const words = ["brillar", "desconexión", "transformación", "puro cuidado"];

const { address, phoneDisplay, hours } = contact;
---

<section id="hero" class="relative h-screen w-full overflow-hidden bg-rose-50 dark:bg-warmgray-900">
  {/* Video de fondo a pantalla completa, con el Navbar fixed y transparente flotando encima. */}
  <video class="absolute inset-0 h-full w-full object-cover" src={bgVideo} autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>

  <div
    class="absolute inset-0 bg-gradient-to-b from-warmgray-900/55 via-warmgray-900/30 to-warmgray-900/60 dark:from-warmgray-900/75 dark:via-warmgray-900/50 dark:to-warmgray-900/80"
    aria-hidden="true"
  >
  </div>

  {/* Widget de contacto — esquina superior izquierda (solo desktop; en mobile hay una versión
     compacta debajo del título, ver más abajo). Mismo lenguaje visual que las tarjetas del
     almanaque: fondo claro/oscuro con blur, borde e íconos simples como los del Footer. */}
  <div class="absolute top-24 left-3 z-20 hidden w-52 flex-col gap-3 rounded-2xl border border-rose-200 bg-white/90 p-4 shadow-[-10px_10px_28px_rgba(0,0,0,0.18)] backdrop-blur-sm sm:top-28 sm:left-6 sm:flex dark:border-warmgray-700 dark:bg-warmgray-800/90">
    <div class="flex items-start gap-2.5">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-500 dark:bg-warmgray-700 dark:text-rose-muted">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7.5V12l3 2" />
        </svg>
      </span>
      <div>
        <p class="font-sans text-[10px] font-semibold tracking-wide text-warmgray-500 uppercase dark:text-warmgray-400">Horario</p>
        <p class="mt-0.5 font-sans text-xs text-warmgray-700 dark:text-warmgray-200">{hours}</p>
      </div>
    </div>

    <div class="flex items-start gap-2.5">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-500 dark:bg-warmgray-700 dark:text-rose-muted">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="M12 21s-7-6.2-7-11.5A7 7 0 0119 9.5C19 14.8 12 21 12 21z" />
          <circle cx="12" cy="9.5" r="2.5" />
        </svg>
      </span>
      <div>
        <p class="font-sans text-[10px] font-semibold tracking-wide text-warmgray-500 uppercase dark:text-warmgray-400">Dirección</p>
        <p class="mt-0.5 font-sans text-xs text-warmgray-700 dark:text-warmgray-200">{address}</p>
      </div>
    </div>

    <div class="flex items-start gap-2.5">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-rose-100 text-rose-500 dark:bg-warmgray-700 dark:text-rose-muted">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
          <path d="M6.5 3.5h3l1.3 3.8-1.9 1.9c.9 2.3 2.7 4.1 5 5l1.9-1.9 3.8 1.3v3c0 .9-.8 1.7-1.7 1.6-8-.5-13.9-6.4-14.4-14.4-.1-.9.7-1.7 1.6-1.7z" />
        </svg>
      </span>
      <div>
        <p class="font-sans text-[10px] font-semibold tracking-wide text-warmgray-500 uppercase dark:text-warmgray-400">Teléfono</p>
        <a href={phoneHref} class="mt-0.5 block font-sans text-xs text-warmgray-700 transition-colors hover:text-rose-500 dark:text-warmgray-200 dark:hover:text-rose-muted">
          {phoneDisplay}
        </a>
      </div>
    </div>
  </div>

  {/* Almanaque de pared: calendario + reloj — esquina superior derecha (solo desktop) */}
  <div class="absolute top-24 right-3 z-20 hidden flex-col items-end gap-3 [perspective:900px] sm:top-28 sm:right-6 sm:flex">
    <div data-tilt-card class="almanac-card almanac-tilt relative w-36 rounded-2xl border border-rose-200 bg-white/90 px-3 pt-4 pb-3 text-center shadow-[-14px_10px_28px_rgba(0,0,0,0.18)] backdrop-blur-sm sm:w-40 dark:border-warmgray-700 dark:bg-warmgray-800/90">
      <span aria-hidden="true" class="absolute -top-2.5 left-1/2 h-3 w-9 -translate-x-1/2 rounded-full bg-rose-300 shadow-sm dark:bg-rose-muted-strong"></span>

      <p class="font-sans text-[10px] font-semibold tracking-[0.2em] text-warmgray-500 uppercase dark:text-warmgray-400" data-almanac-year></p>
      <p class="mt-0.5 font-display text-sm text-warmgray-700 dark:text-warmgray-200" data-almanac-month></p>
      <p class="almanac-glow mt-0.5 font-display text-4xl leading-none text-rose-500 sm:text-5xl dark:text-rose-muted" data-almanac-day></p>

      <div class="mt-3 hidden sm:block">
        <div class="grid grid-cols-7 gap-y-1 font-sans text-[8px] font-semibold text-warmgray-400 uppercase dark:text-warmgray-500" data-almanac-weekdays></div>
        <div class="mt-1 grid grid-cols-7 gap-y-1 font-sans text-[9px] text-warmgray-700 dark:text-warmgray-200" data-almanac-grid></div>
      </div>
    </div>

    <div data-tilt-card class="almanac-card almanac-tilt w-36 rounded-2xl border border-rose-200 bg-white/90 px-3 py-2.5 text-center shadow-[-10px_8px_20px_rgba(0,0,0,0.16)] backdrop-blur-sm sm:w-40 dark:border-warmgray-700 dark:bg-warmgray-800/90">
      <p class="font-sans text-[9px] font-semibold tracking-[0.2em] text-warmgray-500 uppercase dark:text-warmgray-400">Hora actual</p>
      <p class="almanac-glow mt-0.5 font-sans text-xl font-semibold tabular-nums text-rose-500 sm:text-2xl dark:text-rose-muted" data-almanac-clock></p>
    </div>
  </div>

  <div class="relative z-30 flex h-full flex-col items-center justify-center gap-1 px-6 pt-16 text-center sm:pt-20">
    <p class="font-display text-3xl leading-snug text-white sm:text-4xl md:text-5xl">Bienvenida</p>
    <p class="font-display text-2xl leading-snug text-white sm:text-3xl md:text-4xl">a tu momento de</p>
    <p class="font-display text-3xl leading-snug sm:text-4xl md:text-5xl">
      <span class="relative inline-grid text-left align-baseline">
        <span aria-hidden="true" class="invisible col-start-1 row-start-1 text-rose-300">transformación</span>
        <span class="col-start-1 row-start-1 inline-flex items-baseline text-rose-300">
          <span id="typewriter-word" aria-hidden="true"></span>
          <span
            class="ml-0.5 inline-block h-[0.85em] w-[3px] animate-[hero-cursor-blink_1s_steps(1)_infinite] bg-rose-300 align-middle"
            aria-hidden="true"
          ></span>
        </span>
      </span>
      <span class="sr-only">brillar, desconexión, transformación, puro cuidado</span>
    </p>

    {/* Versión compacta de almanaque + contacto para mobile: en pantallas angostas los
       widgets de esquina (arriba) se ocultan y esta franja resume lo mismo en una línea,
       debajo del título, sin robarle espacio vertical al botón CTA. */}
    <div class="mt-3 flex flex-wrap items-center justify-center gap-x-4 gap-y-1.5 rounded-full bg-white/15 px-4 py-2 font-sans text-[11px] text-white backdrop-blur-sm sm:hidden">
      <span class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-rose-300">
          <rect x="3" y="4" width="18" height="17" rx="2" />
          <path d="M3 9h18M8 2v4M16 2v4" />
        </svg>
        <span data-almanac-day></span>
        <span data-almanac-month></span>
      </span>
      <span class="flex items-center gap-1.5">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-rose-300">
          <circle cx="12" cy="12" r="9" />
          <path d="M12 7.5V12l3 2" />
        </svg>
        <span data-almanac-clock></span>
      </span>
      <a href={phoneHref} class="flex items-center gap-1.5 transition-colors hover:text-rose-200">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5 text-rose-300">
          <path d="M6.5 3.5h3l1.3 3.8-1.9 1.9c.9 2.3 2.7 4.1 5 5l1.9-1.9 3.8 1.3v3c0 .9-.8 1.7-1.7 1.6-8-.5-13.9-6.4-14.4-14.4-.1-.9.7-1.7 1.6-1.7z" />
        </svg>
        {phoneDisplay}
      </a>
    </div>

    {/* CTA principal: abre el modal de reserva por WhatsApp (BookingModal, incluido en Layout). */}
    <button
      type="button"
      data-booking-trigger
      aria-haspopup="dialog"
      class="group mt-6 inline-flex cursor-pointer items-center gap-3 rounded-full bg-white/90 pl-6 pr-1.5 py-1.5 font-sans text-sm font-semibold text-rose-600 shadow-lg backdrop-blur-sm transition-colors hover:bg-white sm:mt-8 sm:pl-7 sm:text-base dark:bg-warmgray-800/90 dark:text-rose-muted dark:hover:bg-warmgray-800"
    >
      Reservá tu turno
      <span
        aria-hidden="true"
        class="flex h-10 w-10 items-center justify-center rounded-full bg-[radial-gradient(circle_at_35%_30%,var(--color-rose-200),var(--color-rose-400))] shadow-lg shadow-rose-400/40 transition-transform duration-300 ease-out group-hover:-translate-y-1 group-hover:rotate-6 sm:h-12 sm:w-12 dark:bg-[radial-gradient(circle_at_35%_30%,var(--color-rose-muted),var(--color-rose-muted-strong))] dark:shadow-black/40"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-white sm:h-6 sm:w-6">
          <rect x="3" y="4" width="18" height="17" rx="2" />
          <path d="M3 9h18M8 2v4M16 2v4" />
          <path d="M8.5 14.5l2 2 4-4" />
        </svg>
      </span>
    </button>
  </div>

  <WaveDivider
    id="hero-gallery"
    color1="#F7B2CB"
    color2="#F28FB2"
    color3="#FBD3E0"
    color4="#908190"
    darkColor1="#a9697f"
    darkColor2="#c98ba0"
    darkColor3="#5c5049"
    darkColor4="#342c2c"
  />
</section>

<style>
  @keyframes hero-cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .almanac-card {
    transform-style: preserve-3d;
    will-change: transform;
  }

  /* "Encendido" cálido en modo oscuro: el día y la hora se leen como si tuvieran luz propia */
  :global(.dark) .almanac-glow {
    text-shadow:
      0 0 10px rgba(247, 178, 203, 0.65),
      0 0 22px rgba(250, 204, 150, 0.45);
  }

  [data-almanac-grid] > span,
  [data-almanac-weekdays] > span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 1.1rem;
  }

  [data-almanac-grid] > span[data-today] {
    position: relative;
    font-weight: 600;
    color: white;
  }

  [data-almanac-grid] > span[data-today]::before {
    content: "";
    position: absolute;
    inset: 0.05rem;
    z-index: -1;
    border-radius: 9999px;
    background-color: var(--color-rose-400, #f28fb2);
  }

  :global(.dark) [data-almanac-grid] > span[data-today]::before {
    background-color: var(--color-rose-muted-strong, #a9697f);
  }
</style>

<script>
  import { gsap } from "gsap";

  // --- Typewriter (sin cambios) ---
  const words = ["brillar", "desconexión", "transformación", "puro cuidado"];
  const TYPE_MS = 80;
  const DELETE_MS = 40;
  const HOLD_MS = 1800;
  const PAUSE_BEFORE_NEXT_MS = 300;

  const wordEl = document.getElementById("typewriter-word");
  let wordIndex = 0;

  function typeChar(word: string, charIndex: number) {
    if (!wordEl) return;
    wordEl.textContent = word.slice(0, charIndex);

    if (charIndex < word.length) {
      setTimeout(() => typeChar(word, charIndex + 1), TYPE_MS);
    } else {
      setTimeout(() => eraseChar(word, word.length), HOLD_MS);
    }
  }

  function eraseChar(word: string, charIndex: number) {
    if (!wordEl) return;
    wordEl.textContent = word.slice(0, charIndex);

    if (charIndex > 0) {
      setTimeout(() => eraseChar(word, charIndex - 1), DELETE_MS);
    } else {
      wordIndex = (wordIndex + 1) % words.length;
      setTimeout(() => typeChar(words[wordIndex], 0), PAUSE_BEFORE_NEXT_MS);
    }
  }

  typeChar(words[wordIndex], 0);

  // --- Almanaque: calendario + reloj, generados con Date de JS ---
  const MONTH_NAMES = [
    "Enero",
    "Febrero",
    "Marzo",
    "Abril",
    "Mayo",
    "Junio",
    "Julio",
    "Agosto",
    "Septiembre",
    "Octubre",
    "Noviembre",
    "Diciembre",
  ];
  const WEEKDAY_LETTERS = ["L", "M", "M", "J", "V", "S", "D"];

  // querySelectorAll (no querySelector): el día/mes/hora se muestran dos veces —una en las
  // tarjetas de esquina (desktop) y otra en la franja compacta (mobile)— y ambas copias deben
  // quedar sincronizadas.
  const yearEls = document.querySelectorAll<HTMLElement>("[data-almanac-year]");
  const monthEls = document.querySelectorAll<HTMLElement>("[data-almanac-month]");
  const dayEls = document.querySelectorAll<HTMLElement>("[data-almanac-day]");
  const weekdaysEl = document.querySelector<HTMLElement>("[data-almanac-weekdays]");
  const gridEl = document.querySelector<HTMLElement>("[data-almanac-grid]");
  const clockEls = document.querySelectorAll<HTMLElement>("[data-almanac-clock]");

  function renderCalendar() {
    const now = new Date();
    const year = now.getFullYear();
    const month = now.getMonth();
    const today = now.getDate();

    yearEls.forEach((el) => (el.textContent = String(year)));
    monthEls.forEach((el) => (el.textContent = MONTH_NAMES[month]));
    dayEls.forEach((el) => (el.textContent = String(today)));

    if (weekdaysEl && !weekdaysEl.childElementCount) {
      weekdaysEl.innerHTML = WEEKDAY_LETTERS.map((letter) => `<span>${letter}</span>`).join("");
    }

    if (gridEl) {
      const firstWeekday = new Date(year, month, 1).getDay(); // 0 = domingo
      const mondayFirstOffset = (firstWeekday + 6) % 7; // 0 = lunes
      const daysInMonth = new Date(year, month + 1, 0).getDate();

      const cells: string[] = [];
      for (let i = 0; i < mondayFirstOffset; i++) {
        cells.push("<span></span>");
      }
      for (let day = 1; day <= daysInMonth; day++) {
        const isToday = day === today;
        cells.push(`<span${isToday ? " data-today" : ""}>${day}</span>`);
      }
      gridEl.innerHTML = cells.join("");
    }
  }

  function renderClock() {
    if (!clockEls.length) return;
    const now = new Date();
    const hh = String(now.getHours()).padStart(2, "0");
    const mm = String(now.getMinutes()).padStart(2, "0");
    const ss = String(now.getSeconds()).padStart(2, "0");
    const value = `${hh}:${mm}:${ss}`;
    clockEls.forEach((el) => (el.textContent = value));
  }

  renderCalendar();
  renderClock();
  setInterval(renderClock, 1000);
  // El día puede cambiar mientras la página sigue abierta; una revisión por minuto alcanza.
  setInterval(renderCalendar, 60000);

  // --- Tilt sutil al pasar el mouse sobre las tarjetas del almanaque ---
  const MAX_CARD_TILT_DEG = 10;
  const CARD_TILT_SMOOTHING = 0.15;

  document.querySelectorAll<HTMLElement>("[data-tilt-card]").forEach((card) => {
    const setRotateX = gsap.quickSetter(card, "rotationX", "deg");
    const setRotateY = gsap.quickSetter(card, "rotationY", "deg");

    let currentX = 0;
    let currentY = 0;
    let targetX = 0;
    let targetY = 0;
    let animating = false;

    function tick() {
      currentX += (targetX - currentX) * CARD_TILT_SMOOTHING;
      currentY += (targetY - currentY) * CARD_TILT_SMOOTHING;
      setRotateX(currentX);
      setRotateY(currentY);

      if (Math.abs(targetX - currentX) > 0.05 || Math.abs(targetY - currentY) > 0.05) {
        requestAnimationFrame(tick);
      } else {
        animating = false;
      }
    }

    function startTick() {
      if (!animating) {
        animating = true;
        requestAnimationFrame(tick);
      }
    }

    card.addEventListener("mousemove", (event) => {
      const rect = card.getBoundingClientRect();
      const relX = (event.clientX - rect.left) / rect.width - 0.5;
      const relY = (event.clientY - rect.top) / rect.height - 0.5;
      targetY = relX * MAX_CARD_TILT_DEG;
      targetX = -relY * MAX_CARD_TILT_DEG;
      startTick();
    });

    card.addEventListener("mouseleave", () => {
      targetX = 0;
      targetY = 0;
      startTick();
    });
  });
</script>
