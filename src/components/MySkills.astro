---
import { skillCategories } from "../data/skills";
import logoImg from "../assets/logo.png";
import bgCardImg from "../assets/bg-card.png";
import bgSkillImg from "../assets/bg-skill.png";
import WaveDivider from "./WaveDivider.astro";
---

<section id="skills" class="relative bg-rose-50 px-3 py-20 sm:px-6 md:py-28 dark:bg-warmgray-900">
  {/* Fondo de la sección: `background-size: cover` (no un % de zoom fijo) para que siempre
     cubra el alto real de la sección sin importar cuánto crezca el contenido en mobile (donde
     las tarjetas se apilan 2x2 y la sección es más alta). Filtro oscuro sutil en claro y más
     marcado en oscuro para que el texto tenga buen contraste sobre la imagen en ambos temas. */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0 min-h-full dark:opacity-20"
    style={`background-image: url(${bgSkillImg.src}); background-size: cover; background-position: center; background-repeat: no-repeat;`}
  />
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 min-h-full bg-warmgray-900/45 dark:bg-warmgray-900/75" />

  <div class="relative z-10 mx-auto max-w-6xl">
    {/* Texto blanco fijo (no dark:) con una sombra sutil: va siempre sobre la foto de fondo
       (bg-skill.png), que en modo claro queda muy clara y dejaba el texto oscuro sin contraste. */}
    <div class="mb-12 text-center [text-shadow:0_1px_4px_rgba(0,0,0,0.4)] md:mb-16">
      <p class="font-sans text-xs font-semibold tracking-widest text-white uppercase">Especialidades</p>
      <h2 class="mt-2 font-display text-3xl text-white md:text-5xl">Servicios que ofrecemos</h2>
      <p class="mx-auto mt-3 max-w-xl font-sans font-medium text-white">
        Elegí una categoría para descubrir todo lo que hacemos en cada área.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-4 sm:gap-6 md:grid-cols-4">
      {
        skillCategories.map((category, i) => (
          <button
            type="button"
            data-skill-card
            data-index={i}
            aria-haspopup="dialog"
            class="group relative aspect-square overflow-hidden rounded-2xl border border-rose-200 bg-white p-4 text-center shadow-md transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-rose-400 sm:aspect-auto sm:p-6 dark:border-warmgray-700 dark:bg-warmgray-800"
          >
            {/* Halo permanente, suave */}
            <span
              aria-hidden="true"
              class="pointer-events-none absolute -inset-2 rounded-3xl bg-rose-300/30 blur-xl transition-opacity duration-300 group-hover:opacity-80 dark:bg-rose-muted/20"
            />
            {/* Brillo que se desliza al hover */}
            <span
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 -translate-x-full skew-x-12 bg-gradient-to-r from-transparent via-white/50 to-transparent transition-transform duration-700 ease-out group-hover:translate-x-full dark:via-white/15"
            />
            <span class="relative z-10 flex h-full flex-col items-center justify-center gap-2 sm:gap-3">
              {/* Fondo circular con degradado radial rosado + sombra, y animación de elevar/rotar al hover */}
              <span
                aria-hidden="true"
                class="flex h-10 w-10 items-center justify-center rounded-full bg-[radial-gradient(circle_at_35%_30%,var(--color-rose-200),var(--color-rose-400))] shadow-lg shadow-rose-400/40 transition-transform duration-300 ease-out group-hover:-translate-y-1 group-hover:rotate-6 sm:h-14 sm:w-14 dark:bg-[radial-gradient(circle_at_35%_30%,var(--color-rose-muted),var(--color-rose-muted-strong))] dark:shadow-black/40"
              >
                {category.id === "cabello" && (
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-white sm:h-7 sm:w-7">
                    <circle cx="6" cy="6" r="2.5" />
                    <circle cx="6" cy="18" r="2.5" />
                    <line x1="20" y1="4" x2="8.5" y2="15.5" />
                    <line x1="14.5" y1="14.5" x2="20" y2="20" />
                    <line x1="8.5" y1="8.5" x2="12" y2="12" />
                  </svg>
                )}
                {category.id === "maquillaje-depilacion" && (
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-white sm:h-7 sm:w-7">
                    <rect x="10.6" y="10" width="2.8" height="10.5" rx="1.3" transform="rotate(-4 12 15)" />
                    <rect x="9.6" y="6.5" width="4.8" height="4" rx="1" transform="rotate(-8 12 8.3)" />
                    <ellipse cx="12" cy="4.3" rx="3.6" ry="3" transform="rotate(-20 12 4.3)" />
                  </svg>
                )}
                {category.id === "estetica" && (
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-white sm:h-7 sm:w-7">
                    <path d="M12 2.5c-4.5 3-7 7-7 11a7 7 0 0014 0c0-4-2.5-8-7-11z" />
                  </svg>
                )}
                {category.id === "masajes" && (
                  <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 text-white sm:h-7 sm:w-7">
                    <ellipse cx="12" cy="18.5" rx="7" ry="2.8" />
                    <ellipse cx="12" cy="13" rx="5.3" ry="2.3" />
                    <ellipse cx="12" cy="8" rx="3.7" ry="1.8" />
                  </svg>
                )}
              </span>

              <span class="font-display text-base leading-snug text-warmgray-800 sm:text-2xl dark:text-warmgray-100">
                {category.title}
              </span>
            </span>
          </button>
        ))
      }
    </div>
  </div>

  {/* Overlay / modal a pantalla completa */}
  <div
    data-modal
    role="dialog"
    aria-modal="true"
    aria-label="Detalle de la categoría"
    class="fixed inset-0 z-[70] hidden items-center justify-center bg-warmgray-900/70 p-4 backdrop-blur-sm dark:bg-black/80"
  >
    <button
      type="button"
      data-modal-close
      aria-label="Cerrar"
      class="absolute top-4 right-4 z-20 flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-warmgray-800 shadow-md transition-colors hover:bg-white sm:top-6 sm:right-6 dark:bg-warmgray-800/90 dark:text-warmgray-100 dark:hover:bg-warmgray-800"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <button
      type="button"
      data-modal-prev
      aria-label="Categoría anterior"
      class="absolute left-1 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-rose-500 shadow-md transition-colors hover:bg-white sm:left-4 sm:h-10 sm:w-10 md:left-8 dark:bg-warmgray-800/90 dark:text-rose-muted dark:hover:bg-warmgray-800"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <button
      type="button"
      data-modal-next
      aria-label="Categoría siguiente"
      class="absolute right-1 z-20 flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-rose-500 shadow-md transition-colors hover:bg-white sm:right-4 sm:h-10 sm:w-10 md:right-8 dark:bg-warmgray-800/90 dark:text-rose-muted dark:hover:bg-warmgray-800"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-5 w-5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <div class="[perspective:1600px]" data-stage>
      <div data-tilt class="[transform-style:preserve-3d]">
        <div data-flip-card class="relative [transform-style:preserve-3d]">
          {/* Caja de 6 caras real: logo (frente) + servicios (reverso, a 180°) + 4 risers
             (arriba/abajo/izquierda/derecha) que cierran el volumen entre ambas por igual. */}
          <div data-face="logo" class="skill-face skill-face-logo">
            <img src={logoImg.src} width={logoImg.width} height={logoImg.height} alt="" aria-hidden="true" class="h-auto max-h-[55%] w-auto max-w-[60%] object-contain" />
          </div>

          <div data-face="services" class="skill-face skill-face-services" style={`--card-bg-image: url(${bgCardImg.src})`}>
            <div
              aria-hidden="true"
              class="pointer-events-none absolute inset-0 z-0 opacity-25 dark:opacity-10"
              style="background-image: var(--card-bg-image); background-size: cover; background-position: center; background-repeat: no-repeat;"
            />

            {/* Imagen protagonista de la categoría: de borde a borde (sin padding), ~42% del
               alto de la cara. Arriba y a los costados ya llega directo a la esquina redondeada
               de la tarjeta; el marco con relieve (ver <style>) va solo en el borde inferior,
               marcando la transición hacia el texto. La imagen real la pone renderContent() en
               el script, igual que el título y la lista de servicios. */}
            <div class="skill-face-image relative z-10" data-category-image>
              <img src="" alt="" class="h-full w-full object-cover" />
            </div>

            <div class="relative z-10 flex w-full flex-1 flex-col items-center overflow-y-auto px-6 pt-4 pb-6">
              <p class="font-sans text-xs font-semibold tracking-widest text-rose-500 uppercase dark:text-rose-muted">Servicios</p>
              <h3 class="mt-1 font-display text-2xl text-warmgray-800 sm:text-3xl dark:text-warmgray-100" data-back-title></h3>
              <ul class="mt-5 w-full space-y-2.5 font-sans text-sm text-warmgray-600 sm:text-base dark:text-warmgray-400" data-back-services></ul>
            </div>
          </div>

          <div data-face="right" class="skill-face skill-face-riser skill-face-riser-x">
            <span class="skill-riser-label" data-label-right></span>
          </div>

          <div data-face="left" class="skill-face skill-face-riser skill-face-riser-x">
            <span class="skill-riser-label" data-label-left></span>
          </div>

          <div data-face="top" class="skill-face skill-face-riser skill-face-riser-y"></div>

          <div data-face="bottom" class="skill-face skill-face-riser skill-face-riser-y"></div>
        </div>
      </div>
    </div>
  </div>

  <WaveDivider
    id="skills-pricing"
    color1="#F7B2CB"
    color2="#F28FB2"
    color3="#FBD3E0"
    color4="#806b59"
    darkColor1="#a9697f"
    darkColor2="#c98ba0"
    darkColor3="#5c5049"
    darkColor4="#332a27"
  />
</section>

<style>
  [data-flip-card] {
    --card-w: min(78vw, 380px);
    --card-h: min(70vh, 460px);
    --card-d: calc(var(--card-w) * 0.11);
    width: var(--card-w);
    height: var(--card-h);
    will-change: transform;
  }

  /* Radio compartido por las 6 caras: debe ser bastante menor que --card-d, o los risers
     (tiras angostas) quedan redondeados en "pastilla" y ya no calzan con las esquinas rectas
     de frente/dorso — eso es lo que generaba el desencaje visual entre caras. */
  .skill-face {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    padding: 1.5rem;
    text-align: center;
    backface-visibility: hidden;
  }

  /* La sombra va sólo en las dos caras principales, no en los risers: una sombra por cada
     tira delgada es lo que hacía que se vieran como cintas sueltas flotando, en vez de cantos
     de un mismo bloque sólido. */
  .skill-face-logo,
  .skill-face-services {
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.35);
  }

  /* Cara "frente" del objeto (visible en rotationY ≡ 0°): el verdadero reverso físico de la
     tarjeta, con el logo. Sin rotación propia: sólo se aleja medio grosor hacia la cámara. */
  .skill-face-logo {
    transform: translateZ(calc(var(--card-d) / 2));
    background-color: white;
    border: 1px solid var(--color-rose-200, #fbd3e0);
  }

  :global(.dark) .skill-face-logo {
    background-color: var(--color-warmgray-800, #4a413d);
    border-color: var(--color-warmgray-700, #5c5049);
  }

  /* Cara "dorso" (visible en rotationY ≡ 180°): la de servicios, la que se ve al abrir.
     padding:0 + align-items:stretch (pisan lo heredado de .skill-face) para que la imagen de
     arriba pueda llegar de borde a borde; el padding original (1.5rem) se lo movimos al div de
     texto de abajo, que además es el único que se centra y se pone flex-1 para ocupar el resto
     del alto disponible. */
  .skill-face-services {
    transform: rotateY(180deg) translateZ(calc(var(--card-d) / 2));
    overflow: hidden;
    background-color: white;
    border: 1px solid var(--color-rose-200, #fbd3e0);
    padding: 0;
    align-items: stretch;
    justify-content: flex-start;
  }

  :global(.dark) .skill-face-services {
    background-color: var(--color-warmgray-800, #4a413d);
    border-color: var(--color-warmgray-700, #5c5049);
  }

  /* Imagen de la categoría: ancho completo, ~42% del alto de la tarjeta (--card-h, definida en
     [data-flip-card]). border-top-*-radius explícito por si algún navegador no recorta bien la
     imagen con el overflow:hidden + border-radius del padre; el "relieve" es solo un borde
     inferior grueso más una sombra doble (luz interior arriba del borde + sombra exterior
     debajo), no un marco completo, ya que arriba y a los costados la imagen ya llega al borde
     de la tarjeta. */
  .skill-face-image {
    width: 100%;
    height: calc(var(--card-h) * 0.42);
    flex-shrink: 0;
    overflow: hidden;
    border-top-left-radius: 0.5rem;
    border-top-right-radius: 0.5rem;
    border-bottom: 4px solid var(--color-rose-300, #f7b2cb);
    box-shadow:
      inset 0 1px 2px rgba(255, 255, 255, 0.5),
      0 2px 4px rgba(0, 0, 0, 0.15);
  }

  :global(.dark) .skill-face-image {
    border-bottom-color: var(--color-rose-muted-strong, #a9697f);
  }

  /* Los 4 risers cierran el volumen entre AMBAS caras (logo y servicios) por igual: su ancho
     (--card-d) es el mismo grosor usado por el translateZ de esas dos caras, así no quedan
     huecos ni descalces de ningún lado. */
  .skill-face-riser {
    background-color: var(--color-rose-300, #f7b2cb);
    border: 1px solid var(--color-rose-400, #f28fb2);
  }

  :global(.dark) .skill-face-riser {
    background-color: var(--color-rose-muted-strong, #a9697f);
    border-color: var(--color-rose-muted, #c98ba0);
  }

  .skill-face-riser-x {
    top: 0;
    right: auto;
    bottom: auto;
    left: calc((var(--card-w) - var(--card-d)) / 2);
    width: var(--card-d);
    height: 100%;
    padding: 0.5rem 0;
  }

  .skill-face-riser-y {
    left: 0;
    right: auto;
    bottom: auto;
    top: calc((var(--card-h) - var(--card-d)) / 2);
    width: 100%;
    height: var(--card-d);
    /* El padding heredado de .skill-face (1.5rem) supera el grosor real del riser (--card-d,
       unos 40px): con box-sizing:border-box eso obligaba al navegador a estirar la caja para
       que el padding entrara, corriendo su alto real (y por lo tanto su centro/transform-origin)
       fuera de --card-d. Por eso el riser quedaba desalineado y con forma de cuña en vez de
       una tira pareja. No hay contenido dentro de estos risers, así que no necesitan padding. */
    padding: 0;
  }

  [data-face="right"] {
    transform: rotateY(90deg) translateZ(calc(var(--card-w) / 2));
  }

  [data-face="left"] {
    transform: rotateY(-90deg) translateZ(calc(var(--card-w) / 2));
  }

  [data-face="top"] {
    transform: rotateX(90deg) translateZ(calc(var(--card-h) / 2));
  }

  [data-face="bottom"] {
    transform: rotateX(-90deg) translateZ(calc(var(--card-h) / 2));
  }

  .skill-riser-label {
    writing-mode: vertical-rl;
    text-orientation: mixed;
    white-space: nowrap;
    font-family: var(--font-sans, "Poppins", sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: white;
  }

  @media (min-width: 640px) {
    .skill-riser-label {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  import { gsap } from "gsap";
  import { skillCategories } from "../data/skills";
  import card1 from "../assets/card/card-1.png";
  import card2 from "../assets/card/card-2.png";
  import card3 from "../assets/card/card-3.png";
  import card4 from "../assets/card/card-4.png";

  // Mismo orden que skillCategories en data/skills.ts.
  const categoryImages = [card1, card2, card3, card4];

  const cards = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-skill-card]"));
  const modal = document.querySelector<HTMLElement>("[data-modal]");
  const tiltWrapper = document.querySelector<HTMLElement>("[data-tilt]");
  const flipCard = document.querySelector<HTMLElement>("[data-flip-card]");
  const closeBtn = document.querySelector<HTMLButtonElement>("[data-modal-close]");
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-modal-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-modal-next]");

  const backTitle = document.querySelector<HTMLElement>("[data-back-title]");
  const backImage = document.querySelector<HTMLImageElement>("[data-category-image] img");
  const backServices = document.querySelector<HTMLElement>("[data-back-services]");
  const labelRight = document.querySelector<HTMLElement>("[data-label-right]");
  const labelLeft = document.querySelector<HTMLElement>("[data-label-left]");

  const SPIN_TURNS = 1.5; // termina en el reverso (múltiplo impar de 180°)
  const SPIN_DEGREES = SPIN_TURNS * 360;
  const SPIN_DURATION = 1.9;
  const CLOSE_DURATION = 1.6;
  const NAV_ENTER_DURATION = 1.6; // la entrada es algo más corta que la salida, para sentirse más ágil
  const NAV_OVERLAP = 0.5; // la entrada arranca bastante antes de que la salida termine, para no sentir el hueco

  let activeIndex = 0;
  let isOpen = false;

  // --- Efecto tilt: la tarjeta sigue al cursor/dedo mientras el modal está abierto ---
  // Vive en un wrapper separado (data-tilt) para no pelear por la propiedad rotationY
  // con las animaciones de giro (apertura/cierre/navegación) que corren sobre flipCard.
  const MAX_TILT_DEG = 10;
  const TILT_SMOOTHING = 0.08;

  const setTiltRotateX = tiltWrapper ? gsap.quickSetter(tiltWrapper, "rotationX", "deg") : null;
  const setTiltRotateY = tiltWrapper ? gsap.quickSetter(tiltWrapper, "rotationY", "deg") : null;

  let currentTiltX = 0;
  let currentTiltY = 0;
  let targetTiltX = 0;
  let targetTiltY = 0;

  function updateTiltTarget(clientX: number, clientY: number) {
    const nx = clientX / window.innerWidth - 0.5;
    const ny = clientY / window.innerHeight - 0.5;
    targetTiltY = nx * MAX_TILT_DEG * 2;
    targetTiltX = -ny * MAX_TILT_DEG * 2;
  }

  function onTiltMouseMove(event: MouseEvent) {
    updateTiltTarget(event.clientX, event.clientY);
  }

  function onTiltTouchMove(event: TouchEvent) {
    const touch = event.touches[0];
    if (touch) updateTiltTarget(touch.clientX, touch.clientY);
  }

  function tiltTick() {
    currentTiltX += (targetTiltX - currentTiltX) * TILT_SMOOTHING;
    currentTiltY += (targetTiltY - currentTiltY) * TILT_SMOOTHING;
    setTiltRotateX?.(currentTiltX);
    setTiltRotateY?.(currentTiltY);
  }

  function startTilt() {
    currentTiltX = currentTiltY = targetTiltX = targetTiltY = 0;
    if (tiltWrapper) gsap.set(tiltWrapper, { rotationX: 0, rotationY: 0 });
    window.addEventListener("mousemove", onTiltMouseMove);
    window.addEventListener("touchmove", onTiltTouchMove, { passive: true });
    gsap.ticker.add(tiltTick);
  }

  function stopTilt() {
    window.removeEventListener("mousemove", onTiltMouseMove);
    window.removeEventListener("touchmove", onTiltTouchMove);
    gsap.ticker.remove(tiltTick);
    if (tiltWrapper) gsap.set(tiltWrapper, { rotationX: 0, rotationY: 0 });
  }

  function renderContent(index: number) {
    const category = skillCategories[index];
    if (!category) return;

    if (backTitle) backTitle.textContent = category.title;
    if (backImage) {
      backImage.src = categoryImages[index]?.src ?? "";
      backImage.alt = `Trabajo de ${category.title}`;
    }
    if (labelRight) labelRight.textContent = category.label;
    if (labelLeft) labelLeft.textContent = category.label;

    if (backServices) {
      backServices.innerHTML = "";
      category.services.forEach((service) => {
        const li = document.createElement("li");
        li.className = "flex items-center justify-center gap-2";

        const icon = document.createElementNS("http://www.w3.org/2000/svg", "svg");
        icon.setAttribute("viewBox", "0 0 20 20");
        icon.setAttribute("fill", "currentColor");
        icon.setAttribute("class", "h-4 w-4 shrink-0 text-rose-400 dark:text-rose-muted");
        const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
        path.setAttribute("fill-rule", "evenodd");
        path.setAttribute(
          "d",
          "M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z",
        );
        path.setAttribute("clip-rule", "evenodd");
        icon.appendChild(path);

        const text = document.createElement("span");
        text.textContent = service;

        li.append(icon, text);
        backServices.appendChild(li);
      });
    }
  }

  function openModal(index: number) {
    if (!flipCard) return;
    activeIndex = index;
    isOpen = true;
    renderContent(activeIndex);
    modal?.classList.remove("hidden");
    modal?.classList.add("flex");
    document.body.style.overflow = "hidden";

    startTilt();

    gsap.killTweensOf(flipCard);
    gsap.set(flipCard, { x: 0, y: "50vh", rotationY: 0 });
    gsap.to(flipCard, {
      y: 0,
      rotationY: SPIN_DEGREES,
      duration: SPIN_DURATION,
      ease: "sine.inOut",
    });
  }

  function closeModal() {
    if (!flipCard || !isOpen) return;
    isOpen = false;
    stopTilt();

    gsap.killTweensOf(flipCard);
    gsap.set(flipCard, { x: 0 });
    gsap.to(flipCard, {
      y: "100vh",
      rotationY: `+=${SPIN_DEGREES}`,
      duration: CLOSE_DURATION,
      ease: "sine.inOut",
      onComplete: () => {
        modal?.classList.add("hidden");
        modal?.classList.remove("flex");
        document.body.style.overflow = "";
      },
    });
  }

  function goTo(delta: number) {
    if (!flipCard) return;
    const total = skillCategories.length;
    const direction = delta > 0 ? 1 : -1; // next sale/entra por la derecha, prev por la izquierda

    gsap.killTweensOf(flipCard);
    const tl = gsap.timeline();

    tl.to(flipCard, {
      x: `${direction * 100}vw`,
      rotationY: `+=${SPIN_DEGREES}`,
      duration: SPIN_DURATION,
      ease: "sine.inOut",
    })
      .call(
        () => {
          activeIndex = ((activeIndex + delta) % total + total) % total;
          renderContent(activeIndex);
          gsap.set(flipCard, { x: `${-direction * 100}vw`, rotationY: 0 });
        },
        undefined,
        `-=${NAV_OVERLAP}`,
      )
      .to(
        flipCard,
        {
          x: 0,
          rotationY: SPIN_DEGREES,
          duration: NAV_ENTER_DURATION,
          ease: "sine.inOut",
        },
        `-=${NAV_OVERLAP}`,
      );
  }

  cards.forEach((card) => {
    card.addEventListener("click", () => {
      const index = Number(card.dataset.index ?? 0);
      openModal(index);
    });
  });

  closeBtn?.addEventListener("click", closeModal);
  prevBtn?.addEventListener("click", () => goTo(-1));
  nextBtn?.addEventListener("click", () => goTo(1));

  modal?.addEventListener("click", (event) => {
    if (event.target === modal) closeModal();
  });

  document.addEventListener("keydown", (event) => {
    if (!isOpen) return;
    if (event.key === "Escape") closeModal();
    if (event.key === "ArrowLeft") goTo(-1);
    if (event.key === "ArrowRight") goTo(1);
  });
</script>
