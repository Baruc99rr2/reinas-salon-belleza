---
// Flor decorativa de las cards de Precios: SVG inline (sin WebGL). El volumen sale de los
// degradados de cada pétalo (oscuro en el centro → color → claro en la punta), dos coronas de
// pétalos a distinta altura, un centro con brillo y una sombra suave. El color viene de
// `flowerColor` en data/pricing.ts.
//
// La animación ("respiración": flota, crece apenas y gira lento) solo corre en desktop y si el
// sistema no pide reducir movimiento; en mobile queda estática, como antes.

interface Props {
  /** Color base de los pétalos en hex, ej. "#f28fb2". */
  color: string;
  /** Identificador único en la página (para los ids de los degradados). */
  uid: string;
  /** Posición de la card: varía el ángulo inicial y desfasa la animación entre flores. */
  index?: number;
  class?: string;
}

const { color, uid, index = 0, class: className } = Astro.props;

// Mezcla un color hex con otro (t = 0 → original, t = 1 → destino).
function mix(hex: string, target: string, t: number): string {
  const parse = (h: string) => {
    const clean = h.replace("#", "");
    const full = clean.length === 3 ? clean.replace(/./g, (c) => c + c) : clean;
    return [0, 2, 4].map((i) => parseInt(full.slice(i, i + 2), 16));
  };
  const a = parse(hex);
  const b = parse(target);
  return "#" + a.map((v, i) => Math.round(v + (b[i] - v) * t).toString(16).padStart(2, "0")).join("");
}

const light = mix(color, "#ffffff", 0.5);
const dark = mix(color, "#000000", 0.35);
const deep = mix(color, "#000000", 0.5);

// Contorno del pétalo: arranca y termina en el centro (0,0) y cierra en punta hacia arriba.
const petal = "M0 0C12.8-7.2 12-27.2 0-38C-12-27.2-12.8-7.2 0 0Z";
const angles = [0, 60, 120, 180, 240, 300];
const ids = { front: `${uid}-front`, back: `${uid}-back`, center: `${uid}-center` };
---

<svg
  viewBox="-50 -50 100 100"
  aria-hidden="true"
  focusable="false"
  class:list={["pricing-flower", className]}
  style={`--flower-delay: ${-index * 0.9}s`}
>
  <defs>
    {/* userSpaceOnUse: el degradado gira junto con cada pétalo, siempre del centro a la punta. */}
    <linearGradient id={ids.back} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="-40">
      <stop offset="0" stop-color={deep}></stop>
      <stop offset="0.6" stop-color={dark}></stop>
      <stop offset="1" stop-color={color}></stop>
    </linearGradient>
    <linearGradient id={ids.front} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="-38">
      <stop offset="0" stop-color={dark}></stop>
      <stop offset="0.45" stop-color={color}></stop>
      <stop offset="1" stop-color={light}></stop>
    </linearGradient>
    <radialGradient id={ids.center} cx="0.35" cy="0.3" r="0.75">
      <stop offset="0" stop-color="#fff7d1"></stop>
      <stop offset="0.45" stop-color="#f4d35e"></stop>
      <stop offset="1" stop-color="#b9861a"></stop>
    </radialGradient>
  </defs>

  <g class="pricing-flower-spin">
    <g transform={`rotate(${index * 17})`}>
      {/* Corona de atrás: más grande, más oscura y corrida 30° → da profundidad. */}
      {angles.map((angle) => <path d={petal} transform={`rotate(${angle + 30}) scale(1.12)`} fill={`url(#${ids.back})`}></path>)}

      {/* Corona de adelante: más clara, con borde fino y una nervadura de luz en el medio. */}
      {
        angles.map((angle) => (
          <g transform={`rotate(${angle})`}>
            <path d={petal} fill={`url(#${ids.front})`} stroke={dark} stroke-opacity="0.45" stroke-width="0.8"></path>
            <path d="M0-5C1.6-14 1.2-24 0-31" fill="none" stroke="#ffffff" stroke-opacity="0.45" stroke-width="1.6" stroke-linecap="round"></path>
          </g>
        ))
      }

      <circle r="10" fill={`url(#${ids.center})`}></circle>
      <circle cx="-3" cy="-3.5" r="2.6" fill="#ffffff" fill-opacity="0.7"></circle>
    </g>
  </g>
</svg>

<style>
  .pricing-flower {
    overflow: visible;
    filter: drop-shadow(0 2px 3px rgba(0, 0, 0, 0.35));
  }

  /* En SVG el transform-origin por defecto es el (0,0) del viewBox, que acá es el centro de la flor. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
    .pricing-flower {
      animation: flower-breathe 5.5s ease-in-out infinite;
      animation-delay: var(--flower-delay, 0s);
    }

    .pricing-flower-spin {
      animation: flower-spin 40s linear infinite;
      animation-delay: var(--flower-delay, 0s);
    }
  }

  @keyframes flower-breathe {
    0%,
    100% {
      transform: translateY(0) scale(1) rotate(-4deg);
    }
    50% {
      transform: translateY(-3px) scale(1.07) rotate(4deg);
    }
  }

  @keyframes flower-spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
