---
import { pricingPlans } from "../data/pricing";
import WaveDivider from "./WaveDivider.astro";
import PricingFlower from "./PricingFlower.astro";
import { getImage } from "astro:assets";

// Fondos optimizados (WebP, 1920px o el tamaño original si es menor) de cada plan, en el mismo orden que pricingPlans. El
// script los lee de data-bg-urls para el cross-fade; "" = plan sin imagen (no cambia el fondo).
const bgUrls = await Promise.all(
  pricingPlans.map(async (plan) =>
    plan.bgImage ? (await getImage({ src: plan.bgImage, format: "webp", width: 1920, quality: 72 })).src : "",
  ),
);
const firstBg = bgUrls.find((url) => url !== "") ?? "";
---

<section id="pricing" data-bg-urls={JSON.stringify(bgUrls)} class="relative overflow-hidden bg-rose-50 px-3 py-20 sm:px-6 md:py-28 dark:bg-warmgray-900">
  {/* Fondo de la sección: la imagen del plan activo, en dos capas <img> superpuestas para el
     cross-fade (ver script + .pricing-bg-layer más abajo) — nunca se corta de golpe, siempre
     hay una entrando en opacity mientras la otra sale. Mismo overlay que en MySkills/Gallery
     para que el texto siga siendo legible encima en los dos temas. */}
  <div class="absolute inset-0 z-0" aria-hidden="true">
    <img data-pricing-bg src={firstBg} alt="" loading="lazy" decoding="async" class="pricing-bg-layer absolute inset-0 h-full w-full object-cover opacity-100" />
    <img data-pricing-bg src={firstBg} alt="" loading="lazy" decoding="async" class="pricing-bg-layer absolute inset-0 h-full w-full object-cover opacity-0" />
  </div>
  <div class="absolute inset-0 z-0 bg-warmgray-900/45 dark:bg-warmgray-900/75" aria-hidden="true" />

  <div class="relative z-10 mx-auto max-w-6xl">
    <div class="mb-12 text-center md:mb-16">
      <p class="font-sans text-xs font-semibold tracking-widest text-rose-500 uppercase dark:text-rose-muted">Precios</p>
      <h2 class="mt-2 font-display text-3xl text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.55)] md:text-5xl">Nuestros planes</h2>
      <p class="mx-auto mt-3 max-w-xl font-sans text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.55)]">
        Elegí el servicio que mejor se adapte a tu momento. Precios de referencia, consultanos por combinaciones a medida.
      </p>
    </div>

    {/* touch-action:pan-y — el swipe horizontal lo maneja el script (touchstart/touchend, ver
       abajo), pan-y deja el scroll vertical de la página intacto y evita que el navegador
       interprete el gesto como algo ambiguo (el mismo tipo de problema que ya causó overflow
       horizontal en otra sección de esta página). */}
    <div class="relative overflow-x-hidden [touch-action:pan-y]" data-carousel>
      <div class="relative h-[540px] overflow-hidden sm:h-[500px] md:[perspective:1400px]" data-stage>
        <div class="absolute inset-0 md:[transform-style:preserve-3d]" data-track>
          {
            pricingPlans.map((plan, i) => (
              <article
                data-card
                data-index={i}
                class:list={[
                  "pricing-card absolute top-1/2 left-1/2 flex w-[min(72vw,20rem)] flex-col rounded-2xl border bg-warmgray-900/55 p-4 text-left shadow-lg backdrop-blur-sm sm:w-[min(80vw,20rem)] sm:p-6 dark:bg-warmgray-900/70",
                  plan.featured
                    ? "border-rose-300 ring-2 ring-rose-200 dark:border-rose-muted dark:ring-rose-muted/25"
                    : "border-rose-100 dark:border-warmgray-700",
                ]}
              >
                {plan.featured && (
                  <span class="absolute -top-3 left-1/2 z-20 -translate-x-1/2 rounded-full bg-rose-700 px-3 py-1 text-xs font-semibold whitespace-nowrap text-white shadow">
                    Más elegido
                  </span>
                )}

                <PricingFlower
                  color={plan.flowerColor ?? "#c98ba0"}
                  uid={`pricing-flower-${plan.id}`}
                  index={i}
                  class="pointer-events-none absolute top-1.5 right-1.5 z-0 h-14 w-14 opacity-60 sm:top-2 sm:right-2 sm:h-20 sm:w-20"
                />

                <div class="relative z-10 flex flex-1 flex-col text-white [text-shadow:0_1px_3px_rgba(0,0,0,0.55)]">
                  <p class="font-sans text-xs font-semibold tracking-wide text-white uppercase">
                    {plan.category}
                  </p>
                  <h3 class="mt-1 font-display text-[clamp(1.125rem,5.5vw,1.5rem)] text-white">
                    {plan.title}
                  </h3>

                  <p class="mt-4 flex items-baseline gap-1">
                    <span class="font-display text-[clamp(1.375rem,7vw,1.875rem)] text-white">
                      {plan.price === "A consultar" ? plan.price : `$${plan.price}`}
                    </span>
                    {plan.period && <span class="font-sans text-sm text-white">{plan.period}</span>}
                  </p>

                  <ul class="mt-5 flex-1 space-y-2 font-sans text-sm text-white">
                    {plan.description.map((item) => (
                      <li class="flex items-start gap-2">
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          viewBox="0 0 20 20"
                          fill="currentColor"
                          class="mt-0.5 h-4 w-4 shrink-0 text-rose-400 dark:text-rose-muted"
                        >
                          <path
                            fill-rule="evenodd"
                            d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z"
                            clip-rule="evenodd"
                          />
                        </svg>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>

                  <button
                    type="button"
                    data-booking-trigger
                    data-booking-plan={plan.title}
                    aria-haspopup="dialog"
                    aria-label={`Consultar por ${plan.title}`}
                    class="mt-6 w-full cursor-pointer rounded-full bg-rose-700 px-4 py-2.5 font-sans text-sm font-semibold text-white transition hover:brightness-110 focus-visible:ring-2 focus-visible:ring-rose-300 focus-visible:outline-none"
                  >
                    Consultar
                  </button>
                </div>
              </article>
            ))
          }
        </div>
      </div>

      <button
        type="button"
        data-prev
        aria-label="Plan anterior"
        class="absolute top-1/2 left-0 z-20 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-rose-200 bg-white text-rose-500 shadow-md transition-colors hover:bg-rose-50 sm:left-2 sm:h-10 sm:w-10 md:left-0 dark:border-warmgray-700 dark:bg-warmgray-800 dark:text-rose-muted dark:hover:bg-warmgray-700"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 sm:h-5 sm:w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <button
        type="button"
        data-next
        aria-label="Plan siguiente"
        class="absolute top-1/2 right-0 z-20 flex h-8 w-8 -translate-y-1/2 items-center justify-center rounded-full border border-rose-200 bg-white text-rose-500 shadow-md transition-colors hover:bg-rose-50 sm:right-2 sm:h-10 sm:w-10 md:right-0 dark:border-warmgray-700 dark:bg-warmgray-800 dark:text-rose-muted dark:hover:bg-warmgray-700"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 sm:h-5 sm:w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      <div class="mt-6 flex justify-center gap-2" data-dots>
        {
          pricingPlans.map((_, i) => (
            <button
              type="button"
              data-dot={i}
              aria-label={`Ir al plan ${i + 1}`}
              class="h-2 w-2 rounded-full bg-rose-200 transition-all duration-300 dark:bg-warmgray-700"
            />
          ))
        }
      </div>
    </div>
  </div>

  {/* Desemboca en Volver al Origen: acuarela y hoja hacia el crema (claro) / la noche (oscuro). */}
  <WaveDivider
    id="pricing-origen"
    color1="#F7B2CB"
    color2="#F6B9AD"
    color3="#C9D3AE"
    color4="#FFF6F1"
    darkColor1="#a9697f"
    darkColor2="#5b4a33"
    darkColor3="#2a3324"
    darkColor4="#171b14"
  />
</section>

<style>
  /* Duración pensada para calzar con .pricing-card (1000ms) sin quedar más lenta que el resto
     del carrusel; BG_TRANSITION_MS en el script usa el mismo valor para el "lock" de navegación. */
  .pricing-bg-layer {
    transition: opacity 900ms ease-in-out;
    will-change: opacity;
  }

  .pricing-card {
    --offset: 0;
    --dist: 0;
    transform: translate(-50%, -50%) translateX(calc(var(--offset) * 190px)) scale(calc(1 - var(--dist) * 0.12));
    opacity: calc(1 - var(--dist) * 0.35);
    z-index: calc(10 - var(--dist));
    transition:
      transform 1000ms ease-in-out,
      opacity 1000ms ease-in-out;
    will-change: transform, opacity;
  }

  @media (min-width: 768px) {
    .pricing-card {
      transform: translate(-50%, -50%) translateX(calc(var(--offset) * 230px)) translateZ(calc(var(--dist) * -160px)) rotateY(
            calc(var(--offset) * -30deg)
          ) scale(calc(1 - var(--dist) * 0.1));
    }
  }

  /* Con "reducir movimiento" los cambios de plan son instantáneos (sin deslizamiento ni fundido). */
  @media (prefers-reduced-motion: reduce) {
    .pricing-card,
    .pricing-bg-layer {
      transition: none;
    }
  }

  [data-dot].is-active {
    background-color: var(--color-rose-500, #e8709a);
    width: 1.5rem;
    border-radius: 9999px;
  }

  :global(.dark) [data-dot].is-active {
    background-color: var(--color-rose-muted, #c98ba0);
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>("[data-carousel]");
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-card]"));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-dot]"));
  const prevBtn = document.querySelector<HTMLButtonElement>("[data-prev]");
  const nextBtn = document.querySelector<HTMLButtonElement>("[data-next]");
  const bgLayers = Array.from(document.querySelectorAll<HTMLImageElement>("[data-pricing-bg]"));
  const bgUrls: string[] = JSON.parse(document.querySelector<HTMLElement>("#pricing")?.dataset.bgUrls ?? "[]");
  const total = cards.length;

  const AUTOPLAY_MS = 4500;
  const SWIPE_THRESHOLD = 50;
  // Debe coincidir con la transition-duration de .pricing-bg-layer en el <style> de arriba:
  // es cuánto tarda el cross-fade del fondo, y también cuánto dura el "lock" de navegación
  // (ver isTransitioning) para que nunca se pueda arrancar un segundo cambio de plan a mitad
  // del fundido anterior — ni haciendo swipe varias veces seguidas muy rápido.
  const BG_TRANSITION_MS = 900;

  let activeIndex = 0;
  let autoplayTimer: ReturnType<typeof setInterval> | undefined;
  let isTransitioning = false;

  // El autoplay corre solo si no hay ningún motivo de pausa activo: mouse encima, foco adentro,
  // modal de reserva abierto o "reducir movimiento" en el sistema. Con un Set, cada motivo se
  // agrega/quita por separado y uno no pisa al otro (ej.: al cerrar el modal el foco vuelve a
  // "Consultar", así que la pausa por foco sigue vigente aunque se haya ido la del modal).
  const pauseReasons = new Set<string>();
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  // Dos capas <img> superpuestas, alternando cuál está "arriba" (opacity 1): la de atrás
  // recibe el src del plan nuevo y sube a opacity 1 mientras la de adelante baja a 0, al mismo
  // tiempo — ese solapamiento es lo que se ve como cross-fade en vez de un corte.
  let frontBgIndex = 0;

  function setBackground(index: number) {
    const bgUrl = bgUrls[index];
    if (!bgUrl || bgLayers.length < 2) return;

    const backIndex = frontBgIndex === 0 ? 1 : 0;
    const frontLayer = bgLayers[frontBgIndex];
    const backLayer = bgLayers[backIndex];

    backLayer.src = bgUrl;
    backLayer.style.opacity = "1";
    frontLayer.style.opacity = "0";
    frontBgIndex = backIndex;
  }

  function render() {
    cards.forEach((card, i) => {
      let offset = i - activeIndex;
      if (offset > total / 2) offset -= total;
      if (offset < -total / 2) offset += total;

      const dist = Math.min(Math.abs(offset), 3);
      card.style.setProperty("--offset", String(offset));
      card.style.setProperty("--dist", String(dist));

      const isActive = offset === 0;
      card.style.pointerEvents = isActive ? "auto" : "none";
      card.setAttribute("aria-hidden", isActive ? "false" : "true");
    });

    dots.forEach((dot, i) => dot.classList.toggle("is-active", i === activeIndex));
  }

  // Todas las formas de navegar (flechas, dots, swipe, autoplay) pasan por acá: mientras
  // isTransitioning esté activo, un plan nuevo simplemente no se acepta — así, aunque el
  // usuario deslice el dedo varias veces seguidas muy rápido, el carrusel avanza de un plan
  // por vez en vez de saltar varios o descontrolarse.
  function goTo(index: number) {
    if (isTransitioning) return;

    const nextIndex = ((index % total) + total) % total;
    if (nextIndex === activeIndex) return;

    isTransitioning = true;
    activeIndex = nextIndex;
    render();
    setBackground(activeIndex);

    setTimeout(() => {
      isTransitioning = false;
    }, BG_TRANSITION_MS);
  }

  function stopAutoplay() {
    if (autoplayTimer) clearInterval(autoplayTimer);
    autoplayTimer = undefined;
  }

  function startAutoplay() {
    stopAutoplay();
    if (pauseReasons.size > 0) return;
    autoplayTimer = setInterval(() => {
      if (!document.hidden) goTo(activeIndex + 1);
    }, AUTOPLAY_MS);
  }

  function setPaused(reason: string, paused: boolean) {
    if (paused) pauseReasons.add(reason);
    else pauseReasons.delete(reason);
    startAutoplay();
  }

  function manualGoTo(index: number) {
    goTo(index);
    startAutoplay(); // reinicia la cuenta (si no hay pausas activas)
  }

  prevBtn?.addEventListener("click", () => manualGoTo(activeIndex - 1));
  nextBtn?.addEventListener("click", () => manualGoTo(activeIndex + 1));

  dots.forEach((dot, i) => {
    dot.addEventListener("click", () => manualGoTo(i));
  });

  // --- Swipe táctil (mobile): touchstart/touchend + touch-action:pan-y en [data-carousel]
  // (ver la clase en el markup) para que el gesto horizontal no interfiera con el scroll
  // vertical normal de la página ni reabra el overflow horizontal ya resuelto antes. ---
  let touchStartX = 0;

  stage?.addEventListener(
    "touchstart",
    (event) => {
      touchStartX = event.touches[0]?.clientX ?? 0;
    },
    { passive: true },
  );

  stage?.addEventListener(
    "touchend",
    (event) => {
      const touchEndX = event.changedTouches[0]?.clientX ?? touchStartX;
      const deltaX = touchEndX - touchStartX;
      if (Math.abs(deltaX) < SWIPE_THRESHOLD) return;
      manualGoTo(deltaX < 0 ? activeIndex + 1 : activeIndex - 1);
    },
    { passive: true },
  );

  // Hover solo con mouse: en pantallas táctiles un toque dispara "enter" pero casi nunca "leave",
  // y el carrusel quedaría pausado para siempre.
  stage?.addEventListener("pointerenter", (event) => {
    if (event.pointerType === "mouse") setPaused("hover", true);
  });
  stage?.addEventListener("pointerleave", (event) => {
    if (event.pointerType === "mouse") setPaused("hover", false);
  });

  // Foco: pausa con foco visible (teclado). Un click o toque en las flechas también les da foco,
  // pero ahí ya actúa el hover (o, en touch, el swipe/autoplay normal).
  stage?.addEventListener("focusin", (event) => {
    if ((event.target as Element).matches(":focus-visible")) setPaused("focus", true);
  });
  stage?.addEventListener("focusout", (event) => {
    // Solo si el foco salió del carrusel (no si pasó de un botón a otro dentro de él).
    if (!stage.contains(event.relatedTarget as Node | null)) setPaused("focus", false);
  });

  // Mientras el modal de reserva está abierto el carrusel no avanza: así la card desde la que se
  // abrió sigue siendo la activa. Al cerrar, el foco vuelve a su "Consultar": si quedó adentro del
  // carrusel, la pausa pasa a ser por foco hasta que salga.
  document.addEventListener("booking:open", () => setPaused("modal", true));
  document.addEventListener("booking:close", () => {
    if (stage?.contains(document.activeElement)) pauseReasons.add("focus");
    setPaused("modal", false);
  });

  if (reducedMotion.matches) pauseReasons.add("reduced-motion");
  reducedMotion.addEventListener("change", (event) => setPaused("reduced-motion", event.matches));

  render();
  startAutoplay();
</script>
