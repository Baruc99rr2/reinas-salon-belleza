---
// Sección "Volver al Origen": la otra cara de la propuesta de Alejandra (talleres grupales de
// Constelaciones Familiares). Va entre "Elegí tu servicio" y el Footer. Se siente como pasar del exterior al
// interior: más aire, más calma, paleta propia del logo (crema, hoja, tronco, acuarela).
import { Image, getImage } from "astro:assets";
import OrigenMark from "./OrigenMark.astro";
import WaveDivider from "./WaveDivider.astro";
import { contact, buildWhatsAppUrl } from "../data/contact";
import { talleres } from "../data/talleres";
import { formatDateEs, todayIso } from "../lib/booking";

const whatsappUrl = buildWhatsAppUrl("Quiero información sobre el próximo taller de Constelaciones Familiares");

// Solo talleres que no pasaron al momento del build: los flyers de talleres viejos ni siquiera
// llegan al HTML. El navegador vuelve a comparar con su fecha (ver script) por si el sitio queda
// publicado después del taller.
const buildDay = todayIso();
const upcoming = await Promise.all(
  [...talleres]
    .filter((taller) => taller.fecha >= buildDay)
    .sort((a, b) => a.fecha.localeCompare(b.fecha))
    .map(async (taller) => {
      const label = formatDateEs(taller.fecha);
      return {
        ...taller,
        label: label.charAt(0).toUpperCase() + label.slice(1),
        flyerFull: taller.flyer ? await getImage({ src: taller.flyer, format: "webp", width: 1024 }) : undefined,
      };
    }),
);

const format = ["Taller grupal", "Cupos limitados", `Facilita ${contact.owner}`];

// Hojitas que caen despacio (posición, tamaño, duración y desfase fijos: sin aleatoriedad en el build).
const leaves = [
  { left: "8%", size: 18, duration: 34, delay: -4, kind: "leaf" },
  { left: "22%", size: 13, duration: 40, delay: -22, kind: "petal" },
  { left: "41%", size: 16, duration: 31, delay: -12, kind: "leaf" },
  { left: "63%", size: 12, duration: 38, delay: -30, kind: "petal" },
  { left: "78%", size: 19, duration: 28, delay: -17, kind: "leaf" },
  { left: "91%", size: 14, duration: 36, delay: -8, kind: "petal" },
];
---

<section
  id="volver-al-origen"
  data-origen
  class="relative overflow-hidden bg-origen-cream px-4 pt-20 pb-36 text-origen-ink sm:px-6 md:pt-28 md:pb-44 dark:bg-gradient-to-b dark:from-origen-night dark:to-origen-night-earth dark:text-origen-moon"
>
  {/* Manchas de acuarela muy suaves (en oscuro: dorado y salvia apagados). */}
  <div aria-hidden="true" class="pointer-events-none absolute -top-24 -left-24 h-80 w-80 rounded-full bg-origen-watercolor/30 blur-3xl dark:bg-origen-gold/10"></div>
  <div aria-hidden="true" class="pointer-events-none absolute top-1/3 -right-28 h-96 w-96 rounded-full bg-origen-watercolor/20 blur-3xl dark:bg-origen-sage/10"></div>
  <div aria-hidden="true" class="pointer-events-none absolute bottom-24 left-1/4 h-72 w-72 rounded-full bg-origen-leaf/10 blur-3xl dark:bg-origen-blush/5"></div>

  <div aria-hidden="true" class="origen-leaves pointer-events-none absolute inset-0">
    {
      leaves.map((leaf) => (
        <span
          class="origen-leaf"
          style={`left: ${leaf.left}; width: ${leaf.size}px; height: ${leaf.size}px; animation-duration: ${leaf.duration}s, ${leaf.duration / 6}s; animation-delay: ${leaf.delay}s, ${leaf.delay}s;`}
        >
          {leaf.kind === "leaf" ? (
            <svg viewBox="0 0 24 24" class="h-full w-full">
              <path d="M12 2C6 6 4 12 6 18c2 3 6 4 6 4s4-1 6-4c2-6 0-12-6-16Z" class="fill-origen-leaf dark:fill-origen-sage" />
              <path d="M12 5v16" class="stroke-origen-leaf-deep dark:stroke-origen-night" stroke-width="1" fill="none" opacity="0.5" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" class="h-full w-full">
              <path d="M12 3c4 3 6 7 4 12-1 3-4 6-4 6s-3-3-4-6c-2-5 0-9 4-12Z" class="fill-origen-watercolor dark:fill-origen-blush" />
            </svg>
          )}
        </span>
      ))
    }
  </div>

  <div class="relative z-10 mx-auto max-w-2xl text-center">
    {/* Frase puente: del exterior (Reinas) al interior (Volver al Origen). */}
    <p data-origen-reveal class="font-display text-lg leading-snug text-origen-ink-soft italic sm:text-xl dark:text-origen-moon-soft">
      {contact.brand} cuida tu exterior.
      <span class="block text-origen-wine not-italic dark:text-origen-blush">Volver al Origen acompaña tu interior.</span>
    </p>

    <div data-origen-reveal style="--reveal-delay: 150ms" class="mt-10">
      <OrigenMark />
    </div>

    <div data-origen-reveal style="--reveal-delay: 300ms" class="mx-auto mt-10 max-w-xl">
      <svg viewBox="0 0 120 16" aria-hidden="true" class="mx-auto h-4 w-28 text-origen-leaf dark:text-origen-gold">
        <path d="M2 8h44M74 8h44" stroke="currentColor" stroke-width="1" opacity="0.6"></path>
        <path d="M60 2c-5 3-6 7-4 11 1 1 4 2 4 2s3-1 4-2c2-4 1-8-4-11Z" fill="currentColor"></path>
      </svg>
      <h3 class="mt-6 font-display text-2xl text-origen-ink sm:text-3xl dark:text-origen-moon">Constelaciones Familiares</h3>
      <p class="mt-4 font-sans leading-relaxed text-origen-ink-soft dark:text-origen-moon-soft">
        Son una forma de mirar tu historia familiar con amor. En un espacio grupal y cuidado, cada persona puede ver los vínculos
        y los lugares que ocupa en su familia, reconocer lo que trae de quienes vinieron antes y elegir, desde ahí, cómo seguir
        su propio camino.
      </p>

      <ul class="mt-8 flex flex-wrap justify-center gap-2 font-sans text-sm">
        {
          format.map((item) => (
            <li class="rounded-full border border-origen-leaf/40 bg-white/60 px-4 py-1.5 text-origen-ink dark:border-origen-gold/30 dark:bg-white/5 dark:text-origen-moon">
              {item}
            </li>
          ))
        }
      </ul>
    </div>

    {/* Próximo taller: se renderizan los talleres que no pasaron al hacer el build; el script deja
       visible solo el primero que siga vigente hoy, o el aviso de "próxima fecha" si no queda ninguno. */}
    <div data-origen-reveal style="--reveal-delay: 450ms" class="mx-auto mt-12 max-w-md text-left">
      {
        upcoming.map((taller, index) => (
          <article
            data-taller
            data-fecha={taller.fecha}
            hidden={index !== 0}
            class="rounded-3xl border border-origen-watercolor/60 bg-white/70 p-5 shadow-sm backdrop-blur-sm sm:p-6 dark:border-origen-gold/25 dark:bg-white/5"
          >
            <div class="flex flex-col gap-5 min-[360px]:flex-row min-[360px]:items-start">
              {taller.flyer && taller.flyerFull && (
                <button
                  type="button"
                  data-lightbox-thumb
                  data-full-src={taller.flyerFull.src}
                  data-full-width={taller.flyerFull.attributes.width}
                  data-full-height={taller.flyerFull.attributes.height}
                  aria-haspopup="dialog"
                  class="group mx-auto block w-28 shrink-0 cursor-pointer overflow-hidden rounded-xl shadow-md ring-1 ring-origen-watercolor/60 transition-shadow hover:shadow-lg focus-visible:ring-2 focus-visible:ring-origen-leaf-deep focus-visible:outline-none min-[360px]:mx-0 dark:ring-origen-gold/30 dark:focus-visible:ring-origen-gold"
                >
                  <Image
                    src={taller.flyer}
                    width={112}
                    densities={[1, 2]}
                    alt={`Flyer del taller de Constelaciones Familiares del ${taller.label.toLowerCase()}`}
                    loading="lazy"
                    class="h-auto w-full transition-transform duration-300 group-hover:scale-[1.03] motion-reduce:transition-none"
                  />
                </button>
              )}
              <div class="min-w-0 flex-1">
                <p class="font-sans text-xs font-semibold tracking-[0.18em] text-origen-leaf-deep uppercase dark:text-origen-gold">Próximo taller</p>
                <p class="mt-1 font-display text-2xl leading-tight text-origen-ink dark:text-origen-moon">{taller.label}</p>
                {taller.horario || taller.intercambio ? (
                  <dl class="mt-3 space-y-1 font-sans text-sm text-origen-ink-soft dark:text-origen-moon-soft">
                    {taller.horario && (
                      <div class="flex gap-2">
                        <dt class="font-semibold text-origen-ink dark:text-origen-moon">Horario:</dt>
                        <dd>{taller.horario}</dd>
                      </div>
                    )}
                    {taller.intercambio && (
                      <div class="flex gap-2">
                        <dt class="font-semibold text-origen-ink dark:text-origen-moon">Intercambio:</dt>
                        <dd>{taller.intercambio}</dd>
                      </div>
                    )}
                  </dl>
                ) : (
                  <p class="mt-3 font-sans text-sm text-origen-ink-soft dark:text-origen-moon-soft">Consultá horario e intercambio.</p>
                )}
                {taller.flyer && <p class="mt-3 font-sans text-xs text-origen-ink-soft dark:text-origen-moon-soft">Tocá el flyer para verlo en grande.</p>}
              </div>
            </div>
          </article>
        ))
      }

      <article
        data-taller-fallback
        hidden={upcoming.length > 0}
        class="rounded-3xl border border-origen-watercolor/60 bg-white/70 p-5 text-center shadow-sm backdrop-blur-sm sm:p-6 dark:border-origen-gold/25 dark:bg-white/5"
      >
        <p class="font-sans text-xs font-semibold tracking-[0.18em] text-origen-leaf-deep uppercase dark:text-origen-gold">Próximo taller</p>
        <p class="mt-1 font-display text-2xl leading-tight text-origen-ink dark:text-origen-moon">Consultá por la próxima fecha</p>
        <p class="mt-2 font-sans text-sm text-origen-ink-soft dark:text-origen-moon-soft">Los talleres son grupales y con cupos limitados.</p>
      </article>
    </div>

    <div data-origen-reveal style="--reveal-delay: 600ms" class="mt-8">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-origen-leaf-deep px-6 py-3 font-sans text-sm font-semibold text-white shadow-md transition hover:brightness-110 focus-visible:ring-2 focus-visible:ring-origen-leaf-deep focus-visible:ring-offset-2 focus-visible:ring-offset-origen-cream focus-visible:outline-none dark:bg-origen-gold dark:text-origen-night dark:focus-visible:ring-origen-gold dark:focus-visible:ring-offset-origen-night"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
          <path
            d="M12 2.5a9.5 9.5 0 00-8.2 14.3L2.5 21l4.3-1.3A9.5 9.5 0 1012 2.5zm5.3 13.4c-.2.6-1.3 1.2-1.8 1.3-.5.1-1 .2-3.2-.7-2.7-1.1-4.5-3.8-4.6-4-.1-.2-1.1-1.5-1.1-2.8 0-1.3.7-2 .9-2.2.2-.2.5-.3.7-.3h.5c.2 0 .4 0 .5.4.2.5.7 1.6.7 1.7.1.1.1.3 0 .4-.1.2-.1.3-.3.4-.1.2-.3.3-.4.5-.2.2-.4.4-.2.7.3.5.9 1.3 1.7 2 .9.8 1.7 1.1 2.1 1.3.2.1.4.1.6-.1.2-.2.6-.7.8-1 .2-.3.4-.2.6-.1l1.6.8c.2.1.3.2.4.3.1.1.1.8-.1 1.4z"
          ></path>
        </svg>
        Pedir información por WhatsApp
      </a>
      <p class="mt-2 font-sans text-xs text-origen-ink-soft dark:text-origen-moon-soft">Se abre WhatsApp en una pestaña nueva.</p>
    </div>
  </div>

  <WaveDivider
    id="origen-footer"
    color1="#F6B9AD"
    color2="#839647"
    color3="#4A3526"
    color4="#2b2422"
    darkColor1="#5b4a33"
    darkColor2="#3c4a2f"
    darkColor3="#1c1712"
    darkColor4="#000000"
  />
</section>

<style>
  /* --- Aparición al entrar en pantalla (solo si el script la activó y no hay "reducir movimiento") --- */
  :global(.origen-motion) [data-origen-reveal] {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 1s ease-out,
      transform 1s ease-out;
    transition-delay: var(--reveal-delay, 0ms);
  }

  :global(.origen-motion.is-visible) [data-origen-reveal] {
    opacity: 1;
    transform: none;
  }

  /* --- Hojas y pétalos que caen despacio, balanceándose --- */
  .origen-leaf {
    position: absolute;
    top: -8%;
    display: none;
    opacity: 0.55;
    animation-name: origen-fall, origen-sway;
    animation-timing-function: linear, ease-in-out;
    animation-iteration-count: infinite, infinite;
    animation-direction: normal, alternate;
    animation-play-state: paused;
  }

  :global(.origen-motion) .origen-leaf {
    display: block;
  }

  :global(.origen-motion.leaves-running) .origen-leaf {
    animation-play-state: running;
  }

  @keyframes origen-fall {
    from {
      translate: 0 0;
      rotate: 0deg;
    }
    to {
      /* Más que el alto de la sección; lo que sobra lo recorta su overflow-hidden. */
      translate: 0 2000px;
      rotate: 220deg;
    }
  }

  @keyframes origen-sway {
    from {
      transform: translateX(-14px);
    }
    to {
      transform: translateX(14px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .origen-leaf {
      display: none !important;
    }

    :global(.origen-motion) [data-origen-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  import { todayIso } from "../lib/booking";

  // --- Próximo taller: mostrar el primero que no haya pasado, según la fecha del navegador ---
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-taller]"));
  const fallback = document.querySelector<HTMLElement>("[data-taller-fallback]");
  const today = todayIso();
  const next = cards.find((card) => (card.dataset.fecha ?? "") >= today);
  cards.forEach((card) => {
    card.hidden = card !== next;
    // Un taller pasado no muestra su flyer (ni lo descarga: la card queda oculta y la imagen es lazy).
  });
  if (fallback) fallback.hidden = Boolean(next);

  // --- Aparición suave y hojas, solo sin "reducir movimiento" ---
  const section = document.querySelector<HTMLElement>("[data-origen]");
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (section && !reduceMotion.matches && "IntersectionObserver" in window) {
    section.classList.add("origen-motion");
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) section.classList.add("is-visible");
          // Las hojas solo se mueven mientras la sección está en pantalla.
          section.classList.toggle("leaves-running", entry.isIntersecting);
        });
      },
      { threshold: 0.12 },
    );
    observer.observe(section);
  }
</script>
